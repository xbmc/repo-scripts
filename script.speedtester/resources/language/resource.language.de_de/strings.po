msgid "Test"
msgstr "Test"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Upload-Geschwindigkeit testen"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Deaktivieren, um nur den Download zu testen."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Ergebnisse an speedtest.net senden"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Ergebnis an speedtest.net senden und das Ergebnisbild anzeigen."

msgctxt "#30930"
msgid "Advanced"
msgstr "Erweitert"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Verbindungs-Timeout (Sekunden)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Netzwerk-Timeout für jede Anfrage."

msgctxt "#30933"
msgid "Log level"
msgstr "Protokollierungsstufe"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Detailgrad der Einträge im Kodi-Protokoll."

msgctxt "#30935"
msgid "Quiet"
msgstr "Still"

msgctxt "#30936"
msgid "Info"
msgstr "Info"

msgctxt "#30937"
