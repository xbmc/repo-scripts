                <align>center</align><font>font30_title</font><textcolor>FFB8C4E0</textcolor>
                <label>$INFO[Window.Property(card_line)]</label>
            </control>
            <control type="label">
                <left>0</left><top>900</top><width>1920</width><height>60</height>
                <align>center</align><font>font27</font><textcolor>AAFFFFFF</textcolor>
                <label>$INFO[Window.Property(ch_number)]  $INFO[Window.Property(ch_name)]   •   $INFO[System.Time]</label>
            </control>
        </control>

