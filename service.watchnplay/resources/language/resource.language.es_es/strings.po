msgctxt "#32003"
msgid "Disconnect"
msgstr "Desconectar"

msgctxt "#32004"
msgid "Sync now"
msgstr "Sincronizar ahora"

msgctxt "#32005"
msgid "Not connected"
msgstr "No conectado"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Conectado como %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "En pausa: se necesita WatchNPlay Pro"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "Dirección de la API (solo para pruebas)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Escanea el código QR con tu móvil, o abre Datos y sincronización › Kodi en la app e introduce este código:"

msgctxt "#32011"
msgid "Without the app: %s"
msgstr "Sin la app: %s"

msgctxt "#32012"
msgid "Code valid for %s"
msgstr "Código válido durante %s"

