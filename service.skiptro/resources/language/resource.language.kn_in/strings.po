msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "ಇಂಟ್ರೋ/ಕ್ರೆಡಿಟ್ಸ್ ಸ್ಕಿಪ್ ಬಟನ್"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "ಇಂಟ್ರೋ ಮತ್ತು ಕ್ರೆಡಿಟ್ಸ್ ಸಮಯದಲ್ಲಿ ಸ್ಕಿಪ್ ಬಟನ್ ತೋರಿಸುತ್ತದೆ. ವೀಡಿಯೊ ಫೈಲ್‌ಗಳ ಪಕ್ಕದಲ್ಲಿರುವ .skiptro.json ಫೈಲ್‌ಗಳಿಂದ ಸಮಯದ ಮಾಹಿತಿಯನ್ನು ಓದುತ್ತದೆ."

msgctxt "#32001"
msgid "Dialog"
msgstr "ಡೈಲಾಗ್"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "ಡೈಲಾಗ್ ಸ್ವಯಂ ಮುಚ್ಚುವ ಸಮಯ (ಸೆಕೆಂಡುಗಳು)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "ಇಂಟ್ರೋಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸ್ಕಿಪ್ ಮಾಡಿ"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "ಇಂಟ್ರೋ ಸ್ಕಿಪ್ ಮಾಡಿ"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "ಕ್ರೆಡಿಟ್ಸ್ ಸ್ಕಿಪ್ ಮಾಡಿ"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "ಪೋಸ್ಟ್-ಕ್ರೆಡಿಟ್ ದೃಶ್ಯಕ್ಕೆ ಹೋಗಿ"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "ಸ್ಕಿಪ್ ಡೇಟಾವನ್ನು ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ. ಫೈಲ್ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "ಸ್ಕಿಪ್ ಡೇಟಾವನ್ನು ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ. Android ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Kodi ಗಾಗಿ “ಎಲ್ಲಾ ಫೈಲ್‌ಗಳ ಪ್ರವೇಶ” ಆನ್ ಮಾಡಿ."
