msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Botón para saltar a intro/os créditos"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Mostra un botón para saltar a intro e os créditos. Le os datos de tempo dos ficheiros .skiptro.json situados xunto aos ficheiros de vídeo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Diálogo"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Pechar o diálogo automaticamente despois de (segundos)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Saltar as intros automaticamente"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Saltar intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Saltar créditos"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Ir á escena poscréditos"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Non se poden ler os datos de salto. Comproba os permisos do ficheiro."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Non se poden ler os datos de salto. Activa «Acceso a todos os ficheiros» para Kodi na configuración de Android."
