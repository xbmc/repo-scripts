msgstr "[B]Geschwindigkeitstest starten[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Schließen[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Bitte warten…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Geschwindigkeitstest-Add-on läuft[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "speedtest.net-Konfiguration wird abgerufen"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "speedtest.net-Serverliste wird abgerufen"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Test von {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Bester Server wird anhand der Latenz ausgewählt"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Betrieben von: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Host-Server: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Stadt: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Land: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Entfernung: {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping: {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Download-Geschwindigkeit wird getestet…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Download-Geschwindigkeit: {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Upload-Geschwindigkeit wird getestet…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Upload-Geschwindigkeit: {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Empfohlene Download-Geschwindigkeit für Video-Streaming:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3 bis 5 Mbps für SD-Video in 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5 bis 10 Mbps für HD-Video in 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps für bestes 1080p oder Live-TV"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25 bis 50+ Mbps für 4K-Streaming"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Die gemessenen Werte können durch die Grenzen des Geräts beeinflusst sein.[/I]"
