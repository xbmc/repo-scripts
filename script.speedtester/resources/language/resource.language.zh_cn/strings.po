msgctxt "#30900"
msgid "Server"
msgstr "服务器"

msgctxt "#30901"
msgid "Server selection"
msgstr "服务器选择"

msgctxt "#30902"
msgid "Server selection"
msgstr "服务器选择"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "选择测速服务器的方式。"

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "自动（最近）"

msgctxt "#30905"
msgid "By location"
msgstr "按位置"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "指定服务器 ID"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "位置（城市或国家/地区）"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "在指定城市或国家/地区中搜索服务器。"

msgctxt "#30909"
msgid "Server ID"
msgstr "服务器 ID"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "始终使用此 speedtest.net 服务器 ID 进行测试。"

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "优先使用 HTTPS 服务器"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "仅使用支持安全 HTTPS 连接的服务器。"

msgctxt "#30920"
msgid "Test"
msgstr "测试"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "测试上传速度"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "关闭以仅测试下载。"

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "将结果提交到 speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "将结果上传到 speedtest.net 并显示结果图片。"

msgctxt "#30930"
msgid "Advanced"
msgstr "高级"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "连接超时（秒）"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "每个请求的网络超时。"

msgctxt "#30933"
msgid "Log level"
msgstr "日志级别"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "写入 Kodi 日志的详细程度。"

msgctxt "#30935"
msgid "Quiet"
msgstr "安静"

msgctxt "#30936"
msgid "Info"
msgstr "信息"

msgctxt "#30937"
msgid "Verbose"
msgstr "详细"

msgctxt "#30938"
msgid "Debug"
msgstr "调试"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]开始测速[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]关闭[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "请稍候…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]正在运行测速插件[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "正在获取 speedtest.net 配置"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "正在获取 speedtest.net 服务器列表"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "测试来源：{isp}（{ip}）"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "正在根据延迟选择最佳服务器"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "提供商：{sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "主机服务器：{host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "城市：{name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "国家/地区：{country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "距离：{d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping：{latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "正在测试下载速度…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "下载速度：{speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "正在测试上传速度…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "上传速度：{speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]视频流媒体推荐下载速度：[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3 至 5 Mbps 观看 480p 标清视频"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5 至 10 Mbps 观看 720p 高清视频"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps 获得最佳 1080p 或直播电视体验"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25 至 50+ Mbps 用于 4K 流媒体"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]显示的速度可能受设备性能限制影响。[/I]"
