msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Tlačidlo na preskočenie úvodu/titulkov"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Počas úvodu a záverečných titulkov zobrazí tlačidlo na preskočenie. Načítava časové údaje zo súborov .skiptro.json uložených vedľa videosúborov."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialógové okno"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automaticky zavrieť dialóg po (sekundách)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automaticky preskakovať úvody"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Preskočiť úvod"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Preskočiť titulky"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Prejsť na scénu po titulkoch"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nedajú sa načítať údaje na preskočenie. Skontrolujte povolenia súborov."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nedajú sa načítať údaje na preskočenie. V nastaveniach Androidu zapnite pre Kodi „Prístup ku všetkým súborom“."
