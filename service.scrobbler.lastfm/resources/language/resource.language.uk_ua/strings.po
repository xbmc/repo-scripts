msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Скроблер Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Скроблер Last.fm надсилає інформацію про пісні, які ви слухали в Kodi, на last.fm"

msgctxt "#30000"
msgid "General"
msgstr "Загальні"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Надсилати пісні на Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Надсилати пісні з потокового радіо на Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Ім'я користувача Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Пароль користувача Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Підтверджувати надсилання улюблених"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Надсилати музичні відео на Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Більше"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Увімкнути журнал"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "У разі кількох виконавців використовувати тільки першого"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Додати поточну композицію до улюблених?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Додано до ваших улюблених композицій: \"%s\"."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Не вдалося додати до ваших улюблених композицій: \"%s\"."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Не вдалось підключитись до Last.fm"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Не вказано ім'я користувача чи пароль"
