<?xml version="1.0" encoding="UTF-8"?>
<!-- The progress window of a show or season refresh. Same rules as the setup
     window: every control inline, fonts font10/12/13, textures white and tinted
     here, accent colours from window properties set by progress_window.py. -->
<window>
    <zorder>1</zorder>
    <defaultcontrol always="true">32</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6060607">metamender/white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        </control>
        <control type="group">
            <left>410</left><top>250</top><width>1100</width><height>560</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" delay="100"/>
                <effect type="zoom" start="96" end="100" center="auto" tween="sine" easing="out" time="300" delay="100"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="zoom" start="100" end="96" center="auto" tween="sine" easing="out" time="200"/>
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="200"/>
            </animation>
            <control type="image">
                <left>0</left><top>0</top><width>1100</width><height>560</height>
                <texture border="20" colordiffuse="FF1A1D23">metamender/panel.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1100</width><height>560</height>
                <texture border="20" colordiffuse="$INFO[Window.Property(MM.Accent)]">metamender/frame.png</texture>
            </control>

            <!-- Heading: the heartbeat badge and the title, centred together. -->
            <control type="grouplist">
                <left>50</left><top>40</top><width>1000</width><height>56</height>
                <orientation>horizontal</orientation>
                <align>center</align>
                <itemgap>16</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="group">
                    <top>6</top><width>44</width><height>44</height>
                    <control type="image"><width>44</width><height>44</height><texture colordiffuse="$INFO[Window.Property(MM.Accent)]">metamender/badge.png</texture></control>
                    <control type="image"><width>44</width><height>44</height><texture colordiffuse="FF060607">metamender/pulse.png</texture></control>
                </control>
                <control type="label">
                    <width>auto</width><height>56</height>
                    <aligny>center</aligny>
                    <font>font13</font>
                    <textcolor>$INFO[Window.Property(MM.Accent)]</textcolor>
                    <label>[B]$INFO[Window.Property(MM.Heading)][/B]</label>
                </control>
            </control>
            <control type="image">
                <left>100</left><top>106</top><width>900</width><height>3</height>
                <texture colordiffuse="$INFO[Window.Property(MM.Accent)]">metamender/divider.png</texture>
                <animation effect="fade" start="70" end="70" time="0" condition="true">Conditional</animation>
            </control>
            <control type="label">
                <left>80</left><top>126</top><width>940</width><height>44</height>
                <align>center</align><aligny>center</aligny>
                <font>font12</font>
                <textcolor>FFA8AEB8</textcolor>
                <label>$INFO[Window.Property(MM.Current)]</label>
            </control>

            <!-- Set from Python with setPercent: a progress control cannot read
                 a percentage from a window property. -->
            <control type="progress" id="40">
                <left>80</left><top>196</top><width>940</width><height>14</height>
                <texturebg border="6" colordiffuse="FF2A2F38">metamender/row.png</texturebg>
                <lefttexture></lefttexture>
                <midtexture border="6" colordiffuse="$INFO[Window.Property(MM.Accent)]">metamender/row.png</midtexture>
                <righttexture></righttexture>
                <overlaytexture></overlaytexture>
            </control>
            <control type="label">
                <left>80</left><top>220</top><width>470</width><height>36</height>
                <aligny>center</aligny>
                <font>font10</font>
                <textcolor>FFA8AEB8</textcolor>
                <label>$INFO[Window.Property(MM.Count)]</label>
            </control>
            <control type="label">
                <left>550</left><top>220</top><width>470</width><height>36</height>
                <align>right</align><aligny>center</aligny>
                <font>font10</font>
                <textcolor>FFA8AEB8</textcolor>
                <label>$INFO[Window.Property(MM.TimeLeft)]</label>
            </control>

            <!-- Running counts. -->
            <control type="group">
                <left>80</left><top>286</top>
                <control type="image">
                    <left>0</left><top>0</top><width>296</width><height>60</height>
                    <texture border="12" colordiffuse="FF222731">metamender/row.png</texture>
                </control>
                <control type="label">
                    <left>0</left><top>0</top><width>296</width><height>60</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFF1F3F5</textcolor>
                    <label>$INFO[Window.Property(MM.Updated)]</label>
                </control>
                <control type="image">
                    <left>322</left><top>0</top><width>296</width><height>60</height>
                    <texture border="12" colordiffuse="FF222731">metamender/row.png</texture>
                </control>
                <control type="label">
                    <left>322</left><top>0</top><width>296</width><height>60</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFF1F3F5</textcolor>
                    <label>$INFO[Window.Property(MM.Unchanged)]</label>
                </control>
                <control type="image">
                    <left>644</left><top>0</top><width>296</width><height>60</height>
                    <texture border="12" colordiffuse="FF222731">metamender/row.png</texture>
                </control>
                <control type="label">
                    <left>644</left><top>0</top><width>296</width><height>60</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFF1F3F5</textcolor>
                    <label>$INFO[Window.Property(MM.Unchecked)]</label>
                </control>
            </control>

            <!-- Stop and Background centred together. -->
            <control type="grouplist">
                <left>50</left><top>420</top><width>1000</width><height>72</height>
                <orientation>horizontal</orientation>
                <align>center</align>
                <itemgap>28</itemgap>
                <control type="button" id="31">
                    <width>260</width><height>72</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font13</font>
                    <textcolor>FFF1F3F5</textcolor>
                    <focusedcolor>$INFO[Window.Property(MM.ButtonTextFocused)]</focusedcolor>
                    <pulseonselect>false</pulseonselect>
                    <label>$INFO[Window.Property(MM.Stop)]</label>
                    <texturenofocus border="20" colordiffuse="FF2A2F38">metamender/button.png</texturenofocus>
                    <texturefocus border="20" colordiffuse="$INFO[Window.Property(MM.ButtonFocus)]">metamender/button.png</texturefocus>
                </control>
                <control type="button" id="32">
                    <width>260</width><height>72</height>
                    <align>center</align><aligny>center</aligny>
                    <font>font13</font>
                    <textcolor>FFF1F3F5</textcolor>
                    <focusedcolor>$INFO[Window.Property(MM.ButtonTextFocused)]</focusedcolor>
                    <pulseonselect>false</pulseonselect>
                    <label>[B]$INFO[Window.Property(MM.Background)][/B]</label>
                    <texturenofocus border="20" colordiffuse="FF2A2F38">metamender/button.png</texturenofocus>
                    <texturefocus border="20" colordiffuse="$INFO[Window.Property(MM.ButtonFocus)]">metamender/button.png</texturefocus>
                </control>
            </control>
        </control>
    </controls>
</window>
