msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Intro/titrlarni oʻtkazib yuborish tugmasi"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Intro va yakuniy titrlar paytida oʻtkazib yuborish tugmasini koʻrsatadi. Vaqt maʼlumotlarini video fayllar yonidagi .skiptro.json fayllaridan oʻqiydi."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialog oynasi"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Dialog oynasini avtomatik yopish vaqti (soniya)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Introlarni avtomatik oʻtkazib yuborish"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Introni oʻtkazish"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Titrlarni oʻtkazish"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Titrdan keyingi sahnaga oʻtish"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Oʻtkazish maʼlumotlarini oʻqib boʻlmadi. Fayl ruxsatlarini tekshiring."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Oʻtkazish maʼlumotlarini oʻqib boʻlmadi. Android sozlamalarida Kodi uchun «Barcha fayllarga ruxsat» funksiyasini yoqing."
