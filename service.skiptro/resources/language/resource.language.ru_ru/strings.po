msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Кнопка пропуска заставки и титров"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Показывает кнопку пропуска во время заставки и титров. Считывает данные о времени из файлов .skiptro.json, расположенных рядом с видеофайлами."

msgctxt "#32001"
msgid "Dialog"
msgstr "Диалоговое окно"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Автоматически закрывать окно через (секунд)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Автоматически пропускать заставки"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Пропустить заставку"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Пропустить титры"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Перейти к сцене после титров"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Не удаётся прочитать данные для пропуска. Проверьте права доступа к файлу."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Не удаётся прочитать данные для пропуска. Включите для Kodi «Доступ ко всем файлам» в настройках Android."
