msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Last.fm scrobbler"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "O scrobbler Last.fm irá submeter info de músicas que estiveres escutando no Kodi para o last.fm"

msgctxt "#30000"
msgid "General"
msgstr "Geral"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Enviar músicas para o Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Submeter streaming de rádio para o Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Nome de usuário Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Senha Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Confirmar marcações de Preferidas/Banidas"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Envie videoclipes para o Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Avançado"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Habilitar registro"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "Em caso de múltiplos artistas, use apenas o primeiro"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Você quer adicionar a faixa atual às suas preferidas?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Adicionada às suas faixas preferidas: '%s'."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Não foi possível adicionar '%s' às suas faixas preferidas."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Falha na conexão ao Last.fm"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Nenhum nome de usuário ou senha informado"
