<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
    <section id="service.seenr">
        <category id="connection" label="30000">
            <group id="1">
                <setting id="endpoint" type="string" label="30001" help="30002">
                    <level>0</level>
                    <default></default>
                    <!-- Sans allowempty, Kodi refuse un défaut vide et JETTE le
                         réglage en silence : le champ n'apparaît jamais. -->
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30001</heading>
                    </control>
                </setting>
                <setting id="notify" type="boolean" label="30003" help="30004">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
