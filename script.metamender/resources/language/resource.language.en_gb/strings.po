# --- Certifications (32200-32268) ---

msgctxt "#32200"
msgid "Certifications"
msgstr ""

msgctxt "#32201"
msgid "Certification format"
msgstr ""

msgctxt "#32202"
msgid "Country"
msgstr ""

msgctxt "#32203"
msgid "The rating system to fill in: its valid ratings, its prefix and how other countries' ratings are converted to it. Automatic uses the region of Kodi's interface language; certifications are skipped when that region has no rating system here."
msgstr ""

msgctxt "#32204"
msgid "Override certification prefix"
msgstr ""

msgctxt "#32205"
msgid "Use a custom prefix instead of the default for the selected country. Enable this if your Kodi skin expects a specific prefix format."
msgstr ""

msgctxt "#32206"
msgid "Custom prefix"
msgstr ""

msgctxt "#32207"
msgid "The prefix written before every certification, at most 8 characters (for example \"de:\" or \"Rated \"). Leave empty for no prefix."
msgstr ""

msgctxt "#32210"
msgid "Country scrapers"
msgstr ""

msgctxt "#32211"
msgid "Enable FSK lookup"
msgstr ""

msgctxt "#32212"
msgid "Ask the German FSK when TMDB has no certification. Its ratings count directly for Germany and are converted for the other countries."
msgstr ""

msgctxt "#32213"
msgid "Enable BBFC lookup"
msgstr ""

msgctxt "#32214"
msgid "Ask the British Board of Film Classification when TMDB has no certification. Its ratings count directly for the United Kingdom and are converted for the other countries."
msgstr ""

msgctxt "#32215"
msgid "Enable Medieraadet lookup"
msgstr ""

msgctxt "#32216"
msgid "Ask the Danish Media Council (Medieraadet) when TMDB has no certification. It rates films only. Its ratings count directly for Denmark and are converted for the other countries."
msgstr ""

msgctxt "#32220"
msgid "Correction"
msgstr ""

msgctxt "#32221"
msgid "Replace incorrect certifications"
msgstr ""

msgctxt "#32222"
msgid "Replace a certification from another country's system, such as \"Rated PG-13\" in a Dutch library. Ratings already in the selected country's system are kept, and ratings from an NFO file are never replaced. When disabled, only empty certifications are filled."
msgstr ""

msgctxt "#32230"
msgid "Fallback"
msgstr ""

msgctxt "#32231"
msgid "Apply certification when not found"
msgstr ""

msgctxt "#32232"
msgid "When no source has a certification for an item after a year of monthly rechecks, write the value below, so the item shows it was checked. When disabled, such items stay empty."
msgstr ""

msgctxt "#32233"
msgid "Not-found certification"
msgstr ""

msgctxt "#32234"
msgid "The value written when no source has a certification, exactly as entered (no country prefix). Common values: NR, Not Rated, Unrated."
msgstr ""

