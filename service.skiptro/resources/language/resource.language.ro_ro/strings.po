msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Buton pentru omiterea introducerii/genericului"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Afișează un buton de omitere în timpul introducerii și al genericului de final. Citește datele de sincronizare din fișierele .skiptro.json aflate lângă fișierele video."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Închide automat dialogul după (secunde)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Omite automat introducerile"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Omite introducerea"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Omite genericul"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Salt la scena post-generic"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nu se pot citi datele de omitere. Verificați permisiunile fișierului."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nu se pot citi datele de omitere. Activați „Acces la toate fișierele” pentru Kodi în setările Android."
