<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.subtitles.subtitledb"
       name="SubtitleDB"
       version="0.3.2"
       provider-name="SubtitleDB">
  <requires>
    <!-- Kodi 19 Matrix is the floor: it is the first release on Python 3, and the
         shared client is written for it. -->
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.subtitle.module" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Subtitles from SubtitleDB</summary>
    <description lang="en_GB">Subtitles from the SubtitleDB open index. No account, no key and no quota. Films are found by their IMDb id, episodes by series, season and episode number, and a subtitle recorded against the file you are playing is preferred over one that merely matches the title.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/thesubtitledb/subtitledb-integrations/tree/main/plugins/kodi</source>
    <website>https://thesubtitledb.org</website>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
