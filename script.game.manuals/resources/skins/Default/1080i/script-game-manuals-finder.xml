<?xml version="1.0" encoding="UTF-8"?>
<!--
  Find a manual. The add-on sets:
    Window.Property(state)     searching | results | empty | noproviders | downloading | failed
    Window.Property(game)      the game's name
    Window.Property(provider)  the provider being asked, and provider.icon
    Window.Property(progress)  the download's progress, as text
  and resizes control 410, the download bar's fill. Each result carries the
  provider's manual.* properties, which the detail panel shows.
-->
<window>
	<defaultcontrol always="true">200</defaultcontrol>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<animation effect="fade" time="250">WindowOpen</animation>
	<animation effect="fade" time="200">WindowClose</animation>
	<controls>
		<!-- The focused manual's fanart, dimmed, behind everything -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="E6000000">white.png</texture>
		</control>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
			<colordiffuse>40FFFFFF</colordiffuse>
			<texture background="true">$INFO[Container(200).ListItem.Art(fanart)]</texture>
			<visible>String.IsEqual(Window.Property(state),results) | String.IsEqual(Window.Property(state),downloading)</visible>
		</control>

		<control type="group">
			<left>160</left>
			<top>80</top>
			<width>1600</width>
			<height>920</height>
			<animation type="WindowOpen" reversible="false">
				<effect type="zoom" start="94" end="100" center="960,540" time="250" tween="cubic" easing="out"/>
			</animation>
			<control type="image">
				<left>-60</left>
				<top>-50</top>
				<width>1720</width>
				<height>1040</height>
				<texture border="60">shadow.png</texture>
			</control>
			<control type="image">
				<width>1600</width>
				<height>920</height>
				<texture border="24" colordiffuse="FF1A2123">panel.png</texture>
			</control>

			<!-- Header -->
			<control type="image">
				<left>40</left>
				<top>34</top>
				<width>64</width>
				<height>64</height>
				<texture colordiffuse="FF12A0C7">manual.png</texture>
			</control>
			<control type="label">
				<left>128</left>
				<top>26</top>
				<width>900</width>
				<height>50</height>
				<font>font14</font>
				<label>[B]$ADDON[script.game.manuals 32002][/B]</label>
			</control>
			<control type="label">
				<left>128</left>
				<top>72</top>
				<width>900</width>
				<height>36</height>
				<font>font12</font>
				<textcolor>FFA0A6AB</textcolor>
				<label>$INFO[Window.Property(game)]</label>
			</control>
			<control type="group">
				<right>40</right>
				<top>40</top>
				<width>520</width>
				<height>52</height>
				<visible>!String.IsEmpty(Window.Property(provider))</visible>
				<control type="label">
					<left>0</left>
					<width>452</width>
					<height>52</height>
					<font>font12</font>
					<align>right</align>
					<aligny>center</aligny>
					<textcolor>FFA0A6AB</textcolor>
					<label>$ADDON[script.game.manuals 32014] [COLOR FFFFFFFF]$INFO[Window.Property(provider)][/COLOR]</label>
				</control>
				<control type="image">
					<left>468</left>
					<width>52</width>
					<height>52</height>
					<aspectratio>keep</aspectratio>
					<texture fallback="noproviders.png" colordiffuse="FFA0A6AB">$INFO[Window.Property(provider.icon)]</texture>
				</control>
			</control>
			<control type="image">
				<left>40</left>
				<top>130</top>
				<width>1520</width>
				<height>2</height>
				<texture colordiffuse="FF2A3236">white.png</texture>
			</control>

			<!-- Searching, nothing found, no providers, failed -->
			<control type="group">
				<top>160</top>
				<width>1600</width>
				<height>600</height>
				<visible>!String.IsEqual(Window.Property(state),results) + !String.IsEqual(Window.Property(state),downloading)</visible>
				<animation effect="fade" time="200">Visible</animation>
				<!-- Estuary's busy spinner: its two images and their animations -->
				<control type="group">
					<left>760</left>
					<top>180</top>
					<width>80</width>
					<height>80</height>
					<visible>String.IsEqual(Window.Property(state),searching)</visible>
					<control type="image">
						<centerleft>50%</centerleft>
						<centertop>50%</centertop>
						<width>80</width>
						<height>80</height>
						<aspectratio>keep</aspectratio>
						<animation effect="rotate" end="-45" center="auto" time="200" delay="600" loop="true" reversible="false" condition="true">Conditional</animation>
						<texture colordiffuse="FF12A0C7">spinner.png</texture>
					</control>
					<control type="image">
						<centerleft>50%</centerleft>
						<centertop>50%</centertop>
						<width>50</width>
						<height>50</height>
						<aspectratio>keep</aspectratio>
						<animation effect="rotate" end="45" center="auto" time="200" delay="600" loop="true" reversible="false" condition="true">Conditional</animation>
						<texture flipx="true" colordiffuse="FF12A0C7">spinner.png</texture>
					</control>
				</control>
				<control type="image">
					<left>720</left>
					<top>140</top>
					<width>160</width>
					<height>160</height>
					<texture colordiffuse="FF5A646A">noresults.png</texture>
					<visible>String.IsEqual(Window.Property(state),empty)</visible>
				</control>
				<control type="image">
					<left>720</left>
					<top>140</top>
					<width>160</width>
					<height>160</height>
					<texture colordiffuse="FF5A646A">noproviders.png</texture>
					<visible>String.IsEqual(Window.Property(state),noproviders)</visible>
				</control>
				<control type="image">
					<left>720</left>
					<top>140</top>
					<width>160</width>
					<height>160</height>
					<texture colordiffuse="FFE0703A">failed.png</texture>
					<visible>String.IsEqual(Window.Property(state),failed)</visible>
				</control>
				<control type="label">
					<left>200</left>
					<top>330</top>
					<width>1200</width>
					<height>50</height>
					<font>font13</font>
					<align>center</align>
					<label>$INFO[Window.Property(status)]</label>
				</control>
				<control type="label">
					<left>200</left>
					<top>386</top>
					<width>1200</width>
					<height>40</height>
					<font>font12</font>
					<align>center</align>
					<textcolor>FFA0A6AB</textcolor>
					<label>$INFO[Window.Property(hint)]</label>
				</control>
			</control>

			<!-- Results -->
			<control type="list" id="200">
				<left>40</left>
				<top>160</top>
				<width>720</width>
				<height>600</height>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<ondown>300</ondown>
				<scrolltime tween="quadratic">200</scrolltime>
				<visible>String.IsEqual(Window.Property(state),results) | String.IsEqual(Window.Property(state),downloading)</visible>
				<itemlayout height="150" width="720">
					<control type="image">
						<left>16</left>
						<top>15</top>
						<width>88</width>
						<height>120</height>
						<aspectratio>keep</aspectratio>
						<texture fallback="manual.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>128</left>
						<top>22</top>
						<width>570</width>
						<height>44</height>
						<font>font13</font>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>128</left>
						<top>66</top>
						<width>570</width>
						<height>34</height>
						<font>font12</font>
						<textcolor>FFA0A6AB</textcolor>
						<label>$INFO[ListItem.Property(manual.system)]$INFO[ListItem.Property(manual.year),  ·  ]</label>
					</control>
					<control type="label">
						<left>128</left>
						<top>100</top>
						<width>570</width>
						<height>30</height>
						<font>font10</font>
						<textcolor>FF7A848A</textcolor>
						<label>$INFO[ListItem.Property(manual.size)]</label>
					</control>
				</itemlayout>
				<focusedlayout height="150" width="720">
					<control type="image">
						<width>720</width>
						<height>150</height>
						<texture border="24" colordiffuse="FF12A0C7">panel.png</texture>
						<visible>Control.HasFocus(200)</visible>
					</control>
					<control type="image">
						<width>720</width>
						<height>150</height>
						<texture border="24" colordiffuse="FF2A3236">panel.png</texture>
						<visible>!Control.HasFocus(200)</visible>
					</control>
					<control type="image">
						<left>16</left>
						<top>15</top>
						<width>88</width>
						<height>120</height>
						<aspectratio>keep</aspectratio>
						<texture fallback="manual.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>128</left>
						<top>22</top>
						<width>570</width>
						<height>44</height>
						<font>font13</font>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>128</left>
						<top>66</top>
						<width>570</width>
						<height>34</height>
						<font>font12</font>
						<textcolor>E6FFFFFF</textcolor>
						<label>$INFO[ListItem.Property(manual.system)]$INFO[ListItem.Property(manual.year),  ·  ]</label>
					</control>
					<control type="label">
						<left>128</left>
						<top>100</top>
						<width>570</width>
						<height>30</height>
						<font>font10</font>
						<textcolor>B3FFFFFF</textcolor>
						<label>$INFO[ListItem.Property(manual.size)]</label>
					</control>
				</focusedlayout>
			</control>

			<!-- The highlighted manual -->
			<control type="group">
				<left>800</left>
				<top>160</top>
				<width>760</width>
				<height>600</height>
				<visible>String.IsEqual(Window.Property(state),results) | String.IsEqual(Window.Property(state),downloading)</visible>
				<control type="image">
					<width>760</width>
					<height>600</height>
					<texture border="24" colordiffuse="FF20292C">panel.png</texture>
				</control>
				<control type="image">
					<left>30</left>
					<top>30</top>
					<width>220</width>
					<height>300</height>
					<aspectratio aligny="top">keep</aspectratio>
					<fadetime>200</fadetime>
					<texture fallback="manual.png" background="true">$INFO[Container(200).ListItem.Art(poster)]</texture>
				</control>
				<control type="textbox">
					<left>276</left>
					<top>26</top>
					<width>454</width>
					<height>100</height>
					<font>font13</font>
					<label>[B]$INFO[Container(200).ListItem.Label][/B]</label>
				</control>
				<control type="grouplist">
					<left>276</left>
					<top>128</top>
					<width>454</width>
					<height>210</height>
					<itemgap>2</itemgap>
					<orientation>vertical</orientation>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.system))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32015]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.system)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.region))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32016]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.region)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.year))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32017]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.year)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.publisher))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32018]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.publisher)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.developer))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32019]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.developer)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.genre))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32020]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.genre)]</label>
						</control>
					</control>
					<control type="group">
						<width>454</width>
						<height>28</height>
						<visible>!String.IsEmpty(Container(200).ListItem.Property(manual.size))</visible>
						<control type="label">
							<width>140</width>
							<height>28</height>
							<font>font10</font>
							<textcolor>FF7A848A</textcolor>
							<label>$ADDON[script.game.manuals 32021]</label>
						</control>
						<control type="label">
							<left>150</left>
							<width>304</width>
							<height>28</height>
							<font>font10</font>
							<label>$INFO[Container(200).ListItem.Property(manual.size)]</label>
						</control>
					</control>
				</control>
				<control type="textbox">
					<left>30</left>
					<top>356</top>
					<width>700</width>
					<height>150</height>
					<font>font12</font>
					<textcolor>FFC8CED2</textcolor>
					<label>$INFO[Container(200).ListItem.Property(manual.plot)]</label>
				</control>
				<!-- Download hint, or the download's progress -->
				<control type="label">
					<left>30</left>
					<top>530</top>
					<width>700</width>
					<height>40</height>
					<font>font12</font>
					<textcolor>FF12A0C7</textcolor>
					<label>$ADDON[script.game.manuals 32010]</label>
					<visible>String.IsEqual(Window.Property(state),results)</visible>
				</control>
				<control type="group">
					<left>30</left>
					<top>522</top>
					<visible>String.IsEqual(Window.Property(state),downloading)</visible>
					<control type="label">
						<width>700</width>
						<height>32</height>
						<font>font12</font>
						<label>$ADDON[script.game.manuals 32007]$INFO[Window.Property(progress),  ]</label>
					</control>
					<control type="image" id="400">
						<top>40</top>
						<width>700</width>
						<height>12</height>
						<texture border="5" colordiffuse="FF2A3236">bar.png</texture>
					</control>
					<control type="image" id="410">
						<top>40</top>
						<width>12</width>
						<height>12</height>
						<texture border="5" colordiffuse="FF12A0C7">bar.png</texture>
					</control>
				</control>
			</control>

			<!-- Buttons -->
			<control type="grouplist" id="390">
				<left>40</left>
				<top>800</top>
				<width>1520</width>
				<height>80</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>20</itemgap>
				<onup>200</onup>
				<control type="button" id="300">
					<width>460</width>
					<height>80</height>
					<font>font12</font>
					<label>$ADDON[script.game.manuals 32022]</label>
					<label2>$INFO[Window.Property(provider)]</label2>
					<textoffsetx>30</textoffsetx>
					<texturefocus border="16" colordiffuse="FF12A0C7">button.png</texturefocus>
					<texturenofocus border="16" colordiffuse="FF2A3236">button.png</texturenofocus>
					<aligny>center</aligny>
					<visible>Integer.IsGreater(Window.Property(providers),1)</visible>
				</control>
				<control type="button" id="310">
					<width>300</width>
					<height>80</height>
					<font>font12</font>
					<label>$ADDON[script.game.manuals 32006]</label>
					<texturefocus border="16" colordiffuse="FF12A0C7">button.png</texturefocus>
					<texturenofocus border="16" colordiffuse="FF2A3236">button.png</texturenofocus>
					<align>center</align>
					<aligny>center</aligny>
				</control>
				<control type="button" id="320">
					<width>300</width>
					<height>80</height>
					<font>font12</font>
					<label>222</label>
					<texturefocus border="16" colordiffuse="FF12A0C7">button.png</texturefocus>
					<texturenofocus border="16" colordiffuse="FF2A3236">button.png</texturenofocus>
					<align>center</align>
					<aligny>center</aligny>
				</control>
			</control>
		</control>
	</controls>
</window>
