<?xml version="1.0" encoding="UTF-8"?>
<!-- Every control is inline: Kodi resolves includes and named colours from the active skin only, never from a script's own skin folder. Fonts are anchor names that skin_fonts.py maps onto the active skin. -->
<window>
    <zorder>1</zorder>
    <!-- Not the viewer list: it is empty until onInit fills it, so Kodi cannot focus it when the window opens and logs an error. onInit moves focus to it. -->
    <defaultcontrol always="true">21</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6090A0D">crosswatch/white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        </control>
        <control type="group">
            <left>340</left><top>110</top><width>1240</width><height>860</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" delay="100"/>
                <effect type="zoom" start="96" end="100" center="auto" tween="sine" easing="out" time="300" delay="100"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="zoom" start="100" end="96" center="auto" tween="sine" easing="out" time="200"/>
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="200"/>
            </animation>
            <control type="image">
                <left>0</left><top>0</top><width>1240</width><height>860</height>
                <texture border="28">crosswatch/panel.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1240</width><height>6</height>
                <texture>crosswatch/gradient.png</texture>
            </control>
            <control type="label">
                <left>50</left><top>40</top><width>220</width><height>50</height>
                <aligny>center</aligny>
                <font>font25_title</font>
                <textcolor>FF9299A6</textcolor>
                <label>CROSSWATCH</label>
            </control>
            <!-- Centred on the panel, between the brand and the count; a long heading is cut at
                 this width rather than running into either. -->
            <control type="label">
                <left>270</left><top>40</top><width>700</width><height>50</height>
                <align>center</align><aligny>center</aligny>
                <font>font32_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <label>$INFO[Window.Property(CW.Heading)]</label>
            </control>
            <control type="label">
                <left>990</left><top>40</top><width>200</width><height>50</height>
                <align>right</align><aligny>center</aligny>
                <font>font13</font>
                <textcolor>FF9299A6</textcolor>
                <label>$INFO[Window.Property(CW.Count)]</label>
            </control>
            <control type="label">
                <left>50</left><top>110</top><width>440</width><height>66</height>
                <aligny>center</aligny>
                <font>font13</font>
                <textcolor>FF9299A6</textcolor>
                <label>$ADDON[service.crosswatch 30118]</label>
                <visible>String.IsEqual(Window.Property(CW.Empty),true)</visible>
            </control>
            <control type="list" id="100">
                <left>50</left><top>110</top><width>440</width><height>608</height>
                <orientation>vertical</orientation>
                <scrolltime>0</scrolltime>
                <pagecontrol>101</pagecontrol>
                <onright>10</onright>
                <ondown>20</ondown>
                <itemlayout width="440" height="76">
                    <control type="image">
                        <left>0</left><top>0</top><width>440</width><height>66</height>
                        <texture border="16">crosswatch/box.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>0</top><width>340</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font30_title</font>
                        <textcolor>FFF1F3F5</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>384</left><top>17</top><width>32</width><height>32</height>
                        <texture colordiffuse="FFD86672">crosswatch/icons/warning.png</texture>
                        <visible>String.IsEqual(ListItem.Property(warn),true)</visible>
                    </control>
                </itemlayout>
                <!-- Kodi draws the selected row with this layout also while focus is on the buttons,
                     which act on that row: the chosen box marks it then. -->
                <focusedlayout width="440" height="76">
                    <control type="image">
                        <left>0</left><top>0</top><width>440</width><height>66</height>
                        <texture border="16">crosswatch/box_focus.png</texture>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>440</width><height>66</height>
                        <texture border="16">crosswatch/box_chosen.png</texture>
                        <visible>!Control.HasFocus(100)</visible>
                    </control>
                    <control type="label">
                        <left>24</left><top>0</top><width>340</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font30_title</font>
                        <textcolor>FFF1F3F5</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>384</left><top>17</top><width>32</width><height>32</height>
                        <texture colordiffuse="FFD86672">crosswatch/icons/warning.png</texture>
                        <visible>String.IsEqual(ListItem.Property(warn),true)</visible>
                    </control>
                </focusedlayout>
            </control>
            <control type="scrollbar" id="101">
                <left>500</left><top>110</top><width>6</width><height>598</height>
                <orientation>vertical</orientation>
                <showonepage>false</showonepage>
                <texturesliderbackground colordiffuse="FF1C222C">crosswatch/white.png</texturesliderbackground>
