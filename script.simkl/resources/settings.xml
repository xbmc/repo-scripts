<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="script.simkl">
    <category id="account" label="32100" help="32101">
      <group id="1">
        <setting id="account_status" type="string" label="32102" help="32101">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <dependencies>
            <dependency type="enable" setting="never">true</dependency>
          </dependencies>
          <control type="edit" format="string">
            <heading>32102</heading>
          </control>
        </setting>
        <setting id="login" type="action" label="32103" help="32104">
          <level>0</level>
          <data>RunScript(script.simkl, action=login)</data>
          <dependencies>
            <dependency type="visible" setting="login_state" operator="is">0</dependency>
          </dependencies>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="reconnect" type="action" label="32273" help="32274">
          <level>0</level>
          <data>RunScript(script.simkl, action=login)</data>
          <dependencies>
            <dependency type="visible" setting="login_state" operator="is">1</dependency>
          </dependencies>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="logout" type="action" label="32105" help="32106">
          <level>0</level>
          <data>RunScript(script.simkl, action=logout)</data>
          <dependencies>
            <dependency type="visible">
              <or>
                <condition setting="login_state" operator="is">1</condition>
                <condition setting="login_state" operator="is">2</condition>
              </or>
            </dependency>
          </dependencies>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
      <group id="2">
        <!-- written by the service: 0 = not connected, 1 = old sign-in, 2 = new sign-in; the three buttons above show by it -->
        <setting id="login_state" type="string" label="32102">
          <level>0</level>
          <default>0</default>
          <visible>false</visible>
          <control type="edit" format="string">
            <heading>32102</heading>
          </control>
        </setting>
        <!-- the 3.x login token; 4.0 keeps the login in identity.json and only reads this once to move it over -->
        <setting id="token" type="string" label="32102">
          <level>0</level>
          <default></default>
          <visible>false</visible>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32102</heading>
          </control>
        </setting>
        <setting id="last_nudge" type="string" label="32102">
          <level>0</level>
          <default></default>
          <visible>false</visible>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32102</heading>
          </control>
        </setting>
        <setting id="login_hint_shown" type="boolean" label="32102">
          <level>0</level>
          <default>false</default>
          <visible>false</visible>
          <control type="toggle"/>
        </setting>
        <setting id="migrated_v4" type="boolean" label="32102">
          <level>0</level>
          <default>false</default>
          <visible>false</visible>
          <control type="toggle"/>
        </setting>
        <setting id="autoscrobble" type="boolean" label="32102">
          <level>0</level>
          <default>true</default>
          <visible>false</visible>
          <control type="toggle"/>
        </setting>
        <setting id="never" type="boolean" label="32102">
          <level>0</level>
          <default>false</default>
          <visible>false</visible>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
