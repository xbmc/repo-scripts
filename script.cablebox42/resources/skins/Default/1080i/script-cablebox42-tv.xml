                <left>150</left><top>280</top><width>300</width><height>560</height>
                <font>font45</font><textcolor>FFFFD24A</textcolor><shadowcolor>FF000000</shadowcolor><align>left</align><wrapmultiline>true</wrapmultiline>
                <label>$INFO[Window.Property(wx_hours_t)]</label>
            </control>
            <control type="label">
                <left>470</left><top>280</top><width>250</width><height>560</height>
                <font>font45</font><textcolor>FFFFFFFF</textcolor><shadowcolor>FF000000</shadowcolor><align>left</align><wrapmultiline>true</wrapmultiline>
                <label>$INFO[Window.Property(wx_hours_v)]</label>
            </control>
            <control type="label">
                <left>740</left><top>280</top><width>1050</width><height>560</height>
                <font>font45</font><textcolor>FFE0E8FF</textcolor><shadowcolor>FF000000</shadowcolor><align>left</align><wrapmultiline>true</wrapmultiline>
                <label>$INFO[Window.Property(wx_hours_c)]</label>
            </control>
            <control type="label">
                <left>150</left><top>860</top><width>1620</width><height>60</height>
                <font>font30_title</font><textcolor>FFFFD24A</textcolor><shadowcolor>FF000000</shadowcolor><align>left</align>
                <label>$INFO[Window.Property(wx_sun)]</label>
            </control>
        </control>
        <control type="group">
            <visible>String.IsEqual(Window.Property(mode),weather) + String.IsEqual(Window.Property(wx_page),nodata)</visible>
            <animation effect="fade" start="0" end="100" time="400">Visible</animation>
            <control type="label">
                <left>150</left><top>380</top><width>1620</width><height>200</height>
                <font>font60</font><textcolor>FFFFFFFF</textcolor><shadowcolor>FF000000</shadowcolor><align>center</align>
                <label>$ADDON[script.cablebox42 32907]</label>
            </control>
            <control type="label">
                <left>150</left><top>540</top><width>1620</width><height>200</height>
                <font>font30_title</font><textcolor>FFE0E8FF</textcolor><shadowcolor>FF000000</shadowcolor><align>center</align><wrapmultiline>true</wrapmultiline>
                <label>$ADDON[script.cablebox42 32908]</label>
            </control>
        </control>

        <!-- ============ Static between channels ============ -->
        <control type="multiimage" id="20">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <imagepath>static</imagepath>
            <timeperimage>45</timeperimage>
            <fadetime>0</fadetime>
            <randomize>true</randomize>
            <aspectratio>stretch</aspectratio>
            <visible>String.IsEqual(Window.Property(static),1)</visible>
        </control>

        <!-- ============ Channel banner (now / next) ============ -->
        <control type="group" id="200">
            <visible>String.IsEqual(Window.Property(banner),1)</visible>
            <animation effect="slide" start="0,260" end="0,0" time="250" tween="cubic" easing="out">Visible</animation>
            <animation effect="slide" start="0,0" end="0,260" time="200">Hidden</animation>
            <control type="image">
                <left>0</left><top>800</top><width>1920</width><height>280</height>
                <texture>banner_bg.png</texture>
            </control>
            <control type="label">
                <left>70</left><top>830</top><width>200</width><height>110</height>
                <font>font60</font><textcolor>FFFFD24A</textcolor><shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window.Property(ch_number)]</label>
            </control>
            <control type="label">
                <left>70</left><top>935</top><width>260</width><height>50</height>
                <font>font27</font><textcolor>FFB8C4E0</textcolor>
                <label>$INFO[Window.Property(ch_call)]</label>
            </control>
            <control type="label">
                <left>300</left><top>830</top><width>1300</width><height>50</height>
                <font>font27</font><textcolor>FFB8C4E0</textcolor>
                <label>$INFO[Window.Property(ch_name)]</label>
            </control>
            <control type="label">
                <left>300</left><top>875</top><width>1300</width><height>70</height>
                <font>font45</font><textcolor>FFFFFFFF</textcolor><shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window.Property(now_title)]</label>
            </control>
            <control type="label">
                <left>300</left><top>945</top><width>1300</width><height>45</height>
                <font>font27</font><textcolor>FFDDE4FF</textcolor>
                <label>$INFO[Window.Property(now_sub)]</label>
            </control>
            <control type="label">
                <left>1550</left><top>830</top><width>300</width><height>50</height>
                <align>right</align><font>font30_title</font><textcolor>FFFFFFFF</textcolor>
                <label>$INFO[System.Time]</label>
            </control>
            <control type="label">
                <left>1450</left><top>885</top><width>400</width><height>50</height>
                <align>right</align><font>font27</font><textcolor>FFB8C4E0</textcolor>
                <label>$INFO[Window.Property(now_time)]</label>
            </control>
            <control type="progress" id="30">
                <left>300</left><top>998</top><width>1550</width><height>10</height>
                <texturebg colordiffuse="55FFFFFF">white.png</texturebg>
                <midtexture colordiffuse="FFFFD24A">white.png</midtexture>
            </control>
            <control type="label">
                <left>300</left><top>1018</top><width>1550</width><height>45</height>
                <font>font27</font><textcolor>FFB8C4E0</textcolor>
                <label>$INFO[Window.Property(next_line)]</label>
            </control>
        </control>

        <!-- ============ VCR style channel number, top right ============ -->
        <control type="group" id="300">
            <visible>String.IsEqual(Window.Property(osd),1)</visible>
            <!-- emitted by the tube, not pasted on: slight transparency + faint interference flicker -->
            <animation effect="fade" start="92" end="78" time="120" condition="true" pulse="true">Conditional</animation>
            <!-- "CH 03": stroke-style cable-box digits, left-aligned after the CH label -->
            <control type="image">
                <left>1290</left><top>60</top><width>230</width><height>140</height>
                <texture colordiffuse="E6FFFFFF">digits/ch.png</texture>
            </control>
            <control type="image">
                <left>1560</left><top>60</top><width>110</width><height>140</height>
                <texture colordiffuse="E6FFFFFF">$INFO[Window.Property(d1)]</texture>
            </control>
            <control type="image">
                <left>1652</left><top>60</top><width>110</width><height>140</height>
                <texture colordiffuse="E6FFFFFF">$INFO[Window.Property(d2)]</texture>
            </control>
            <control type="image">
                <left>1744</left><top>60</top><width>110</width><height>140</height>
                <texture colordiffuse="E6FFFFFF">$INFO[Window.Property(d3)]</texture>
            </control>
        </control>

        <!-- small toast (sleep timer etc.) -->
        <control type="label">
            <left>70</left><top>60</top><width>1300</width><height>60</height>
            <font>font30_title</font><textcolor>FF33FF66</textcolor><shadowcolor>FF000000</shadowcolor>
            <label>$INFO[Window.Property(toast)]</label>
            <visible>!String.IsEmpty(Window.Property(toast))</visible>
        </control>
        <!-- CRT effect (Settings > Viewing): flat overlays only, the video itself is untouched -->
        <control type="group" id="400">
            <visible>!String.IsEmpty(Window.Property(crt))</visible>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture>crt_mask.png</texture>
                <visible>String.IsEqual(Window.Property(crt),2)</visible>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture>scanlines.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>-260</top><width>1920</width><height>260</height>
                <texture>crt_humbar.png</texture>
                <visible>String.IsEqual(Window.Property(crt),2)</visible>
                <animation effect="slide" start="0,1340" end="0,0" time="11000" condition="true" loop="true">Conditional</animation>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture>crt_vignette.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture>crt_bezel.png</texture>
                <visible>String.IsEqual(Window.Property(crt),2)</visible>
            </control>
        </control>
    </controls>
</window>
