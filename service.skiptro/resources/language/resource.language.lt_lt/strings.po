msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Įžangos / titrų praleidimo mygtukas"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Rodo praleidimo mygtuką įžangos ir titrų metu. Laiko duomenis nuskaito iš .skiptro.json failų, esančių šalia vaizdo failų."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialogo langas"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automatiškai uždaryti dialogo langą po (sekundžių)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automatiškai praleisti įžangas"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Praleisti įžangą"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Praleisti titrus"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Pereiti prie scenos po titrų"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nepavyko nuskaityti praleidimo duomenų. Patikrinkite failo leidimus."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nepavyko nuskaityti praleidimo duomenų. Android nustatymuose įjunkite „Prieiga prie visų failų“ programai Kodi."
