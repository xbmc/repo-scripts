msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Ievada un titru izlaišanas poga"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Ievada un titru laikā rāda izlaišanas pogu. Nolasa laika datus no .skiptro.json failiem, kas atrodas blakus video failiem."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialogs"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automātiski aizvērt dialogu pēc (sekundēm)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automātiski izlaist ievadus"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Izlaist ievadu"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Izlaist titrus"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Pāriet uz pēctitru ainu"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nevar nolasīt izlaišanas datus. Pārbaudiet failu atļaujas."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nevar nolasīt izlaišanas datus. Android iestatījumos ieslēdziet „Piekļuve visiem failiem” lietotnei Kodi."
