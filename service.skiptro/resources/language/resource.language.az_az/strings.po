msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "İntro/titrləri keçmə düyməsi"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "İntro və son titrlər zamanı keçmə düyməsini göstərir. Vaxt məlumatlarını video fayllarının yanındakı .skiptro.json fayllarından oxuyur."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialoq"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Dialoqun avtomatik bağlanma vaxtı (saniyə)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "İntroları avtomatik keç"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "İntronu keç"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Titrləri keç"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Titrsonrası səhnəyə keç"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Keçmə məlumatları oxuna bilmir. Fayl icazələrini yoxlayın."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Keçmə məlumatları oxuna bilmir. Android ayarlarında Kodi üçün «Bütün fayllara giriş» icazəsini aktiv edin."
