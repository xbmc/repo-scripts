msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Botwm hepgor y cyflwyniad/credydau"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Yn dangos botwm hepgor yn ystod y cyflwyniad a'r credydau. Yn darllen data amseru o ffeiliau .skiptro.json wrth ymyl y ffeiliau fideo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Deialog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Cau'r deialog yn awtomatig ar ôl (eiliadau)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Hepgor cyflwyniadau'n awtomatig"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Hepgor y cyflwyniad"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Hepgor y credydau"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Neidio i'r olygfa ychwanegol"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Methu darllen y data hepgor. Gwiriwch ganiatadau'r ffeil."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Methu darllen y data hepgor. Trowch “Mynediad i bob ffeil” ymlaen ar gyfer Kodi yng ngosodiadau Android."
