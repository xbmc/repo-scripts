msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Дугме за прескакање уводне/одјавне шпице"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Приказује дугме за прескакање током уводне и одјавне шпице. Чита податке о времену из .skiptro.json датотека поред видео датотека."

msgctxt "#32001"
msgid "Dialog"
msgstr "Дијалог"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Аутоматски затвори дијалог након (секунди)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Аутоматски прескачи уводне шпице"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Прескочи уводну шпицу"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Прескочи одјавну шпицу"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Пређи на сцену после шпице"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Није могуће прочитати податке за прескакање. Проверите дозволе датотеке."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Није могуће прочитати податке за прескакање. Укључите „Приступ свим датотекама“ за Kodi у подешавањима Андроида."
