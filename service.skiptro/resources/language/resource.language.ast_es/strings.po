msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Botón pa saltar la intro/los creitos"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Amuesa un botón pa saltar la intro y los creitos. Llee los datos de tiempu de los ficheros .skiptro.json que tán xunto a los ficheros de videu."

msgctxt "#32001"
msgid "Dialog"
msgstr "Diálogu"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Zarrar el diálogu automáticamente dempués de (segundos)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Saltar les intros automáticamente"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Saltar intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Saltar creitos"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Dir a la escena poscreitos"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nun se puen lleer los datos de saltu. Comprueba los permisos del ficheru."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nun se puen lleer los datos de saltu. Activa «Accesu a tolos ficheros» pa Kodi nos axustes d'Android."
