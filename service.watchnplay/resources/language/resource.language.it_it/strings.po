msgctxt "#32000"
msgid "Account"
msgstr "Account"

msgctxt "#32001"
msgid "Status"
msgstr "Stato"

msgctxt "#32002"
msgid "Connect with WatchNPlay"
msgstr "Connetti a WatchNPlay"

msgctxt "#32003"
msgid "Disconnect"
msgstr "Disconnetti"

msgctxt "#32004"
msgid "Sync now"
msgstr "Sincronizza ora"

msgctxt "#32005"
msgid "Not connected"
msgstr "Non connesso"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Connesso come %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "In pausa: serve WatchNPlay Pro"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "Indirizzo API (solo per test)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Scansiona il codice QR con il telefono, oppure apri Dati e sincronizzazione › Kodi nell'app e inserisci questo codice:"

msgctxt "#32011"
msgid "Without the app: %s"
msgstr "Senza app: %s"

msgctxt "#32012"
msgid "Code valid for %s"
msgstr "Codice valido ancora %s"

msgctxt "#32013"
msgid "Cancel"
msgstr "Annulla"

msgctxt "#32014"
msgid "Connected with %s"
msgstr "Connesso con %s"

msgctxt "#32015"
msgid "Code expired, getting a new one…"
msgstr "Codice scaduto, ne richiedo uno nuovo…"

msgctxt "#32016"
msgid "Too many attempts. Please try again later."
msgstr "Troppi tentativi. Riprova più tardi."

msgctxt "#32017"
msgid "WatchNPlay cannot be reached. Please check your internet connection."
msgstr "WatchNPlay non è raggiungibile. Controlla la connessione a Internet."

msgctxt "#32018"
msgid "Connection removed. You can connect again in the add-on settings."
msgstr "Connessione rimossa. Puoi riconnetterti nelle impostazioni dell'add-on."

msgctxt "#32019"
msgid "WatchNPlay Pro is needed to keep syncing."
msgstr "Serve WatchNPlay Pro per continuare a sincronizzare."

msgctxt "#32020"
msgid "Disconnected from WatchNPlay."
msgstr "Disconnesso da WatchNPlay."

msgctxt "#32021"
msgid "Disconnect this device from WatchNPlay?"
msgstr "Disconnettere questo dispositivo da WatchNPlay?"

msgctxt "#32022"
msgid "Sync started."
msgstr "Sincronizzazione avviata."

msgctxt "#32024"
msgid "Requesting code…"
msgstr "Richiesta del codice…"

msgctxt "#32025"
msgid "Device"
msgstr "Dispositivo"
