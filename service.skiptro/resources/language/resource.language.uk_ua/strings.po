msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Кнопка пропуску заставки/титрів"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Показує кнопку пропуску під час заставки та фінальних титрів. Зчитує дані про час із файлів .skiptro.json поруч із відеофайлами."

msgctxt "#32001"
msgid "Dialog"
msgstr "Діалог"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Автозакриття діалогу через (секунд)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Автоматично пропускати заставки"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Пропустити заставку"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Пропустити титри"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "До сцени після титрів"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Не вдалося прочитати дані пропуску. Перевірте права доступу до файлів."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Не вдалося прочитати дані пропуску. Увімкніть «Доступ до всіх файлів» для Kodi в налаштуваннях Android."
