msgid "WatchNPlay Pro is needed to keep syncing."
msgstr "Você precisa do WatchNPlay Pro para continuar sincronizando."

msgctxt "#32020"
msgid "Disconnected from WatchNPlay."
msgstr "Desconectado do WatchNPlay."

msgctxt "#32021"
msgid "Disconnect this device from WatchNPlay?"
msgstr "Desconectar este dispositivo do WatchNPlay?"

msgctxt "#32022"
msgid "Sync started."
msgstr "Sincronização iniciada."

msgctxt "#32024"
