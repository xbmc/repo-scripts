msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "የመግቢያ/ክሬዲቶች መዝለያ አዝራር"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "በመግቢያ እና በክሬዲቶች ክፍሎች ወቅት የመዝለያ አዝራር ያሳያል። የጊዜ መረጃን ከቪዲዮ ፋይሎች አጠገብ ካሉ .skiptro.json ፋይሎች ያነባል።"

msgctxt "#32001"
msgid "Dialog"
msgstr "የንግግር ሳጥን"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "የንግግር ሳጥኑ በራስ-ሰር የሚዘጋበት ጊዜ (ሰከንዶች)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "መግቢያዎችን በራስ-ሰር ዝለል"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "መግቢያውን ዝለል"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "ክሬዲቶችን ዝለል"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "ወደ ተጨማሪ ትዕይንቱ ዝለል"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "የመዝለያ መረጃውን ማንበብ አልተቻለም። የፋይል ፈቃዶችን ያረጋግጡ።"

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "የመዝለያ መረጃውን ማንበብ አልተቻለም። በAndroid ቅንብሮች ውስጥ ለKodi «የሁሉም ፋይሎች መዳረሻ» ፈቃድን ያብሩ።"
