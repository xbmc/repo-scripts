<!-- CableBox 42 - the "TV set".  Everything is driven by window properties
     set from resources/lib/tv.py, so it works with any Kodi skin. -->
<window>
    <defaultcontrol>9000</defaultcontrol>
    <backgroundcolor>FF000000</backgroundcolor>
    <controls>
        <!-- The picture.  Kodi's own player renders here (with the device's hardware decoding). -->
        <control type="videowindow" id="10">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <visible>String.IsEqual(Window.Property(mode),video)</visible>
        </control>

        <!-- ============ Cards: station ID / up next / technical difficulties ============ -->
        <control type="group" id="100">
            <visible>String.IsEqual(Window.Property(mode),card)</visible>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture>card_bg.jpg</texture>
            </control>
            <control type="label">
                <left>0</left><top>250</top><width>1920</width><height>60</height>
                <align>center</align><font>font27</font><textcolor>FFFFD24A</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window.Property(card_kicker)]</label>
            </control>
            <control type="label">
                <left>60</left><top>330</top><width>1800</width><height>140</height>
                <align>center</align><font>font60</font><textcolor>FFFFFFFF</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window.Property(card_title)]</label>
            </control>
            <control type="label">
                <left>60</left><top>490</top><width>1800</width><height>70</height>
                <align>center</align><font>font37</font><textcolor>FFE0E8FF</textcolor>
