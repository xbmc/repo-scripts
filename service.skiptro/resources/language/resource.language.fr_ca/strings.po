msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Bouton pour passer l'intro et le générique"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Affiche un bouton pour passer l'intro et le générique de fin. Lit les données de minutage dans les fichiers .skiptro.json placés à côté des fichiers vidéo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Boîte de dialogue"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Fermer automatiquement la boîte de dialogue après (secondes)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Passer automatiquement les intros"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Passer l'intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Passer le générique"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Aller à la scène post-générique"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Impossible de lire les données de saut. Vérifiez les autorisations des fichiers."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Impossible de lire les données de saut. Activez « Accès à tous les fichiers » pour Kodi dans les paramètres Android."
