msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "ثبت‌کنندهٔ لست.اف‌ام"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "ثبت‌کنندهٔ لست.اف‌ام، اطّلاعات ترانه‌هایی را که در کودی گوش داده‌اید به لست.اف‌ام می‌فرستد"

msgctxt "#30000"
msgid "General"
msgstr "عمومی"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "ثبت ترانه‌ها در لست.اف‌ام"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "ثبت رادیوی جریانی در لست.اف‌ام"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "نام کاربری لست.اف‌ام"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "گذرواژهٔ لست.اف‌ام"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "تأیید اظهار علاقه‌ها"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "ثبت نماهنگ‌ها در لست.اف‌ام"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr ""

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "به کار انداختن گزارش‌گیری"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr ""

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "لست.اف‌ام"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "می‌خواهید قطعهٔ کنونی را به قطعه‌های محبوبتان بیفزایید؟"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "به قطعه‌های محبوبتان افزوده شد: «%s'»."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "نتوانست «%s» را به قطعه‌های محبوبتان بیفزاید."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
