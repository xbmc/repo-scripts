msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Last.fm kraasija"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Last.fm kraasija saadab last.fm teenusele teabe nende lugude kohta, mida oled Kodis kuulanud"

msgctxt "#30000"
msgid "General"
msgstr "Üldine"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Saada lugude andmed Last.fm teenusele"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Saada voogesitusraadio teave Last.fm teenusele"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Last.fm kasutajanimi"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Last.fm parool"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Kinnita 'Meeldib' esitamine"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Saada muusikavideod Last.fm teenusele"

# empty strings with id 300007
