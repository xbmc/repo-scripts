msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Gumb za preskok uvoda/odjavne špice"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Med uvodom in odjavno špico prikaže gumb za preskok. Podatke o časih prebere iz datotek .skiptro.json, ki so poleg video datotek."

msgctxt "#32001"
msgid "Dialog"
msgstr "Pogovorno okno"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Samodejno zapri pogovorno okno po (sekundah)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Samodejno preskoči uvode"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Preskoči uvod"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Preskoči odjavno špico"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Skoči na prizor po špici"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Podatkov za preskok ni mogoče prebrati. Preverite dovoljenja datoteke."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Podatkov za preskok ni mogoče prebrati. V nastavitvah Androida za Kodi vklopite »Dostop do vseh datotek«."
