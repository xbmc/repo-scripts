msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Gumb za preskakanje uvoda/odjavne špice"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Prikazuje gumb za preskakanje tijekom uvodne i odjavne špice. Čita podatke o vremenu iz datoteka .skiptro.json koje se nalaze pokraj video datoteka."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dijalog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automatski zatvori dijalog nakon (sekundi)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automatski preskoči uvode"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Preskoči uvod"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Preskoči odjavnu špicu"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Prijeđi na scenu nakon špice"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nije moguće pročitati podatke za preskakanje. Provjerite dopuštenja datoteke."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nije moguće pročitati podatke za preskakanje. Uključite „Pristup svim datotekama“ za Kodi u postavkama Androida."
