# --- Refetch schedule settings (32376-32380) ---

msgctxt "#32376"
msgid "Refresh schedule (days)"
msgstr ""

msgctxt "#32377"
msgid "Days between the checks of new content, separated by commas. 7,30,90 checks again about a week after the first check, a month after that, then three months after that; one last check follows when the content reaches the staleness threshold."
msgstr ""

msgctxt "#32378"
msgid "Reset tracker"
msgstr ""

msgctxt "#32379"
msgid "Clear all maturity tracking so every field is re-fetched from scratch on the next scan. Use this after a misconfiguration or when you want to force a full refresh."
msgstr ""

msgctxt "#32380"
msgid "Content age in days before metadata is treated as stable; older content is fetched once, newer content is refreshed on a schedule."
msgstr ""

