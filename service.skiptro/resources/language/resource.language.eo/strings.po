msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Butono por transsalti enkondukon/fintitolojn"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Montras butonon por transsalti dum la enkonduko kaj la fintitoloj. Legas tempajn datumojn el dosieroj .skiptro.json apud la videodosieroj."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialogo"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Aŭtomate fermi dialogon post (sekundoj)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Aŭtomate transsalti enkondukojn"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Transsalti enkondukon"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Transsalti fintitolojn"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Salti al postfina sceno"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Ne eblas legi la transsaltajn datumojn. Kontrolu la dosierpermesojn."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Ne eblas legi la transsaltajn datumojn. Ŝaltu „Aliro al ĉiuj dosieroj“ por Kodi en la agordoj de Android."
