<?xml version="1.0" encoding="UTF-8"?>
<!-- Up Next asks whether anyone is still watching before it plays another episode. The video is dimmed behind the show's logo (or name), the
     episode, its facts and plot on the left; its still and the countdown bar
     (3014) on the right, above the episode now finishing. 3012 is the main
     button, 3013 Close or Stop (labelled by the add-on). -->
<window>
    <defaultcontrol always="true">20</defaultcontrol>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <onload>Dialog.Close(videoosd,true)</onload>
    <controls>
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="400" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="300" />
            </animation>
            <control type="image">
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="B3000000">white.jpg</texture>
            </control>
            <control type="group">
                <control type="label">
                    <left>120</left>
                    <top>150</top>
                    <width>900</width>
                    <height>44</height>
                    <aligny>center</aligny>
                    <font>font30_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>66000000</shadowcolor>
                    <label>$ADDON[service.upnext 30024]</label>
                </control>
                <!-- The show's logo, or its name when it has none -->
                <control type="image">
                    <left>120</left>
                    <top>200</top>
                    <width>900</width>
                    <height>190</height>
                    <aspectratio align="left" aligny="bottom">keep</aspectratio>
                    <texture background="true">$INFO[Window.Property(clearlogo)]</texture>
                </control>
                <control type="label">
                    <left>120</left>
                    <top>310</top>
                    <width>900</width>
                    <height>80</height>
                    <aligny>center</aligny>
                    <font>font52_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>66000000</shadowcolor>
                    <label>$INFO[Window.Property(tvshowtitle)]</label>
                    <visible>String.IsEmpty(Window.Property(clearlogo))</visible>
                </control>
                <control type="label">
                    <left>120</left>
                    <top>408</top>
                    <width>900</width>
                    <height>52</height>
                    <aligny>center</aligny>
                    <font>font36_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>66000000</shadowcolor>
                    <label>$INFO[Window.Property(season),S,]$INFO[Window.Property(episode),E,  ]$INFO[Window.Property(title)]</label>
                </control>
                <control type="grouplist">
                    <left>120</left>
                    <top>466</top>
                    <width>900</width>
                    <height>40</height>
                    <orientation>horizontal</orientation>
                    <itemgap>0</itemgap>
                    <usecontrolcoords>true</usecontrolcoords>
                    <control type="label">
                        <width>auto</width>
                        <height>40</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>B3FFFFFF</textcolor>
                        <label>$INFO[Window.Property(year),,   ]</label>
                        <visible>!String.IsEmpty(Window.Property(year))</visible>
                    </control>
                    <control type="image">
                        <top>10</top>
                        <width>20</width>
                        <height>20</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="FFFF4081">star.png</texture>
                        <visible>!String.IsEmpty(Window.Property(rating))</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>40</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>B3FFFFFF</textcolor>
                        <label>$INFO[Window.Property(rating), ,   ]</label>
                        <visible>!String.IsEmpty(Window.Property(rating))</visible>
                    </control>
                    <control type="label">
                        <width>auto</width>
                        <height>40</height>
                        <aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>B3FFFFFF</textcolor>
                        <label>$ADDON[service.upnext 30009]</label>
                        <visible>!String.IsEmpty(Window.Property(endtime))</visible>
                    </control>
                </control>
                <control type="textbox">
                    <left>120</left>
                    <top>524</top>
                    <width>900</width>
                    <height>180</height>
                    <font>font13</font>
                    <textcolor>B3FFFFFF</textcolor>
                    <shadowcolor>66000000</shadowcolor>
                    <label>$INFO[Window.Property(plot)]</label>
                    <autoscroll>false</autoscroll>
                </control>
                    <control type="button" id="3012">
                        <left>-1000</left>
                        <top>-1000</top>
                        <width>1</width>
                        <height>1</height>
                    </control>
                <control type="grouplist" id="20">
                    <left>120</left>
                    <top>740</top>
                    <width>900</width>
                    <height>72</height>
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>
                    <control type="button" id="10">
                        <width min="260">auto</width>
                        <height>72</height>
                        <label>$ADDON[service.upnext 30056]</label>
                        <font>font25_title</font>
                        <textoffsetx>44</textoffsetx>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FF000000</focusedcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <shadowcolor>00000000</shadowcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <texturefocus border="36" colordiffuse="FFFFFFFF">pill.png</texturefocus>
                        <texturenofocus border="36" colordiffuse="33FFFFFF">pill.png</texturenofocus>
                        <pulseonselect>no</pulseonselect>
                        <onclick>SendClick(3012)</onclick>
                        <visible>Integer.IsGreater(Window.Property(remaining),59)</visible>
                    </control>
                    <control type="button" id="11">
                        <width min="260">auto</width>
                        <height>72</height>
                        <label>$ADDON[service.upnext 30035]</label>
                        <font>font25_title</font>
                        <textoffsetx>44</textoffsetx>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FF000000</focusedcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <shadowcolor>00000000</shadowcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <texturefocus border="36" colordiffuse="FFFFFFFF">pill.png</texturefocus>
                        <texturenofocus border="36" colordiffuse="33FFFFFF">pill.png</texturenofocus>
                        <pulseonselect>no</pulseonselect>
                        <onclick>SendClick(3012)</onclick>
                        <visible>!Integer.IsGreater(Window.Property(remaining),59)</visible>
                    </control>
                    <control type="button" id="3013">
                        <width min="260">auto</width>
                        <height>72</height>
                        <label>$ADDON[service.upnext 30034]</label>
                        <font>font25_title</font>
                        <textoffsetx>44</textoffsetx>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FF000000</focusedcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <shadowcolor>00000000</shadowcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <texturefocus border="36" colordiffuse="FFFFFFFF">pill.png</texturefocus>
                        <texturenofocus border="36" colordiffuse="33FFFFFF">pill.png</texturenofocus>
                        <pulseonselect>no</pulseonselect>
                    </control>
                </control>
            </control>
            <control type="group">
                <control type="image">
                    <left>1160</left>
                    <top>160</top>
                    <width>640</width>
                    <height>360</height>
                    <texture diffuse="rounded.png" colordiffuse="FF1E2230">white.jpg</texture>
                    <visible>String.IsEmpty(Window.Property(thumb)) + String.IsEmpty(Window.Property(landscape)) + String.IsEmpty(Window.Property(fanart))</visible>
                </control>
                <control type="textbox">
                    <left>1200</left>
                    <top>160</top>
                    <width>560</width>
                    <height>360</height>
                    <font>font30_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(tvshowtitle)]</label>
                    <visible>String.IsEmpty(Window.Property(thumb)) + String.IsEmpty(Window.Property(landscape)) + String.IsEmpty(Window.Property(fanart))</visible>
                </control>
                <control type="image">
                    <left>1160</left>
                    <top>160</top>
                    <width>640</width>
                    <height>360</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="rounded.png">$INFO[Window.Property(thumb)]</texture>
                </control>
                <control type="image">
                    <left>1160</left>
                    <top>160</top>
                    <width>640</width>
                    <height>360</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="rounded.png">$INFO[Window.Property(landscape)]</texture>
                    <visible>String.IsEmpty(Window.Property(thumb))</visible>
                </control>
                <control type="image">
                    <left>1160</left>
                    <top>160</top>
                    <width>640</width>
                    <height>360</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="rounded.png">$INFO[Window.Property(fanart)]</texture>
                    <visible>String.IsEmpty(Window.Property(thumb)) + String.IsEmpty(Window.Property(landscape))</visible>
                </control>
                <control type="image">
                    <left>1160</left>
                    <top>536</top>
                    <width>640</width>
                    <height>6</height>
                    <texture colordiffuse="33FFFFFF">white.jpg</texture>
                </control>
                <control type="progress" id="3014">
                    <left>1160</left>
                    <top>536</top>
                    <width>640</width>
                    <height>6</height>
                    <reveal>true</reveal>
                    <lefttexture></lefttexture>
                    <righttexture></righttexture>
                    <overlaytexture></overlaytexture>
                    <texturebg colordiffuse="00FFFFFF">white.jpg</texturebg>
                    <midtexture colordiffuse="FFFF4081">white.jpg</midtexture>
                </control>
            </control>
            <!-- The episode now finishing: from the player, or the preview's
                 preview_finishing_* properties where nothing plays. -->
            <control type="group">
                <left>1160</left>
                <top>592</top>
                <visible>VideoPlayer.Content(episodes) | !String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>192</width>
                        <height>108</height>
                        <aspectratio>scale</aspectratio>
                        <texture diffuse="rounded.png">$INFO[Player.Art(thumb)]</texture>
                        <visible>!!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>192</width>
                        <height>108</height>
                        <aspectratio>scale</aspectratio>
                        <texture diffuse="rounded.png">$INFO[Player.Art(tvshow.landscape)]</texture>
                        <visible>!!String.IsEmpty(Window.Property(preview_finishing_title)) + String.IsEmpty(Player.Art(thumb))</visible>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>192</width>
                        <height>108</height>
                        <aspectratio>scale</aspectratio>
                        <texture diffuse="rounded.png">$INFO[Player.Art(fanart)]</texture>
                        <visible>!!String.IsEmpty(Window.Property(preview_finishing_title)) + String.IsEmpty(Player.Art(thumb)) + String.IsEmpty(Player.Art(tvshow.landscape))</visible>
                    </control>
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>192</width>
                        <height>108</height>
                        <aspectratio>scale</aspectratio>
                        <texture diffuse="rounded.png">$INFO[Window.Property(preview_finishing_art)]</texture>
                        <visible>!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                    </control>
                <control type="label">
                    <left>216</left>
                    <width>424</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>B3FFFFFF</textcolor>
                    <label>$ADDON[service.upnext 30057]</label>
                </control>
                <control type="label">
                    <left>216</left>
                    <top>32</top>
                    <width>424</width>
                    <height>36</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E,  ]$INFO[VideoPlayer.Title]</label>
                    <visible>!!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                </control>
                <control type="label">
                    <left>216</left>
                    <top>32</top>
                    <width>424</width>
                    <height>36</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[Window.Property(preview_finishing_season),S,]$INFO[Window.Property(preview_finishing_episode),E,  ]$INFO[Window.Property(preview_finishing_title)]</label>
                    <visible>!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                </control>
                <control type="image">
                    <left>216</left>
                    <top>84</top>
                    <width>424</width>
                    <height>4</height>
                    <texture colordiffuse="33FFFFFF">white.jpg</texture>
                </control>
                <control type="progress">
                    <left>216</left>
                    <top>84</top>
                    <width>424</width>
                    <height>4</height>
                    <info>Player.Progress</info>
                    <visible>!!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                    <texturebg colordiffuse="00FFFFFF">white.jpg</texturebg>
                    <lefttexture></lefttexture>
                    <righttexture></righttexture>
                    <overlaytexture></overlaytexture>
                    <midtexture colordiffuse="FFFFFFFF">white.jpg</midtexture>
                </control>
                <!-- The preview's bar, fixed at preview_finishing_progress (96%):
                     Kodi sizes no control from a property. -->
                <control type="image">
                    <left>216</left>
                    <top>84</top>
                    <width>407</width>
                    <height>4</height>
                    <texture colordiffuse="FFFFFFFF">white.jpg</texture>
                    <visible>!String.IsEmpty(Window.Property(preview_finishing_title))</visible>
                </control>
            </control>
            <!-- The time -->
            <control type="label">
                <right>120</right>
                <top>60</top>
                <width>400</width>
                <height>60</height>
                <align>right</align>
                <font>font30_title</font>
                <textcolor>B3FFFFFF</textcolor>
                <label>$INFO[System.Time]</label>
                <visible>!Window.IsVisible(extendedprogressdialog)</visible>
            </control>
        </control>
    </controls>
</window>
