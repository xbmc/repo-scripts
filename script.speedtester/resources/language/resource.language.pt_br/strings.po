msgstr "[B]Executando o add-on de teste de velocidade[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Obtendo a configuração do speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Obtendo a lista de servidores do speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Testando de {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Selecionando o melhor servidor pela latência"

