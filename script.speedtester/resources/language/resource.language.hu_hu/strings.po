msgid "Server selection"
msgstr "Szerverválasztás"

msgctxt "#30902"
msgid "Server selection"
msgstr "Szerverválasztás"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Add meg, hogyan válassza ki a teszt-szervert."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automatikus (legközelebbi)"

msgctxt "#30905"
msgid "By location"
msgstr "Helyszín szerint"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "Adott szerver ID"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Helyszín (város vagy ország)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Szerverek keresése adott városban vagy országban."

msgctxt "#30909"
msgid "Server ID"
msgstr "Szerver ID"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Mindig ezzel a speedtest.net szerver ID-vel mérjen."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "HTTPS szerverek előnyben"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Csak biztonságos HTTPS-kapcsolatot támogató szervereket használjon."

msgctxt "#30920"
msgid "Test"
msgstr "Teszt"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Feltöltési sebesség mérése"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Kikapcsolva csak letöltést mér."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Eredmények beküldése a speedtest.net-re"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Eredmény feltöltése a speedtest.net-re és az eredménykép megjelenítése."

msgctxt "#30930"
msgid "Advanced"
msgstr "Haladó"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Kapcsolat időtúllépés (másodperc)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Hálózati időtúllépés kérésenként."

msgctxt "#30933"
msgid "Log level"
msgstr "Naplózási szint"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "A Kodi naplóba írt részletesség mértéke."

msgctxt "#30935"
msgid "Quiet"
msgstr "Néma"

msgctxt "#30936"
msgid "Info"
msgstr "Infó"

msgctxt "#30937"
msgid "Verbose"
msgstr "Bőbeszédű"

msgctxt "#30938"
msgid "Debug"
msgstr "Hibakereső"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]Sebességteszt indítása[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Bezárás[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Kérlek várj…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Sebességteszt kiegészítő fut[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "speedtest.net konfiguráció lekérése"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "speedtest.net szerverlista lekérése"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Mérés innen: {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Legjobb szerver kiválasztása késleltetés alapján"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Üzemeltető: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Szerver: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Város: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Ország: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Távolság: {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping: {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Letöltési sebesség mérése…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Letöltési sebesség: {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Feltöltési sebesség mérése…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Feltöltési sebesség: {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Ajánlott letöltési sebesség videó streameléshez:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3–5 Mbps SD (480p) minőségű videóhoz"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5–10 Mbps HD (720p) minőségű videóhoz"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps a legjobb 1080p vagy élő TV élményhez"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25–50+ Mbps 4K streameléshez"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]A mért sebességet az eszköz korlátai is befolyásolhatják.[/I]"
