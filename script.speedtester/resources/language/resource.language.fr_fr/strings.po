msgctxt "#30900"
msgid "Server"
msgstr "Serveur"

msgctxt "#30901"
msgid "Server selection"
msgstr "Sélection du serveur"

msgctxt "#30902"
msgid "Server selection"
msgstr "Sélection du serveur"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Choisir comment le serveur de test est sélectionné."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automatique (le plus proche)"

msgctxt "#30905"
msgid "By location"
msgstr "Par emplacement"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "ID de serveur spécifique"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Emplacement (ville ou pays)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Rechercher des serveurs dans une ville ou un pays précis."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID de serveur"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Toujours tester avec cet ID de serveur speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Préférer les serveurs HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "N'utiliser que les serveurs prenant en charge le HTTPS sécurisé."

msgctxt "#30920"
msgid "Test"
msgstr "Test"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Tester le débit montant"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Désactiver pour un test en descendant uniquement."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Envoyer les résultats à speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Envoyer le résultat à speedtest.net et afficher l'image du résultat."

msgctxt "#30930"
msgid "Advanced"
msgstr "Avancé"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Délai de connexion (secondes)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Délai réseau pour chaque requête."

msgctxt "#30933"
msgid "Log level"
msgstr "Niveau de journalisation"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Niveau de détail écrit dans le journal Kodi."

msgctxt "#30935"
msgid "Quiet"
msgstr "Silencieux"

msgctxt "#30936"
msgid "Info"
msgstr "Info"

msgctxt "#30937"
msgid "Verbose"
msgstr "Détaillé"

msgctxt "#30938"
msgid "Debug"
msgstr "Débogage"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]Lancer le test de débit[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Fermer[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Veuillez patienter…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Extension de test de débit en cours[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Récupération de la configuration speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Récupération de la liste des serveurs speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Test depuis {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Sélection du meilleur serveur selon la latence"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Hébergé par : {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Serveur hôte : {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Ville : {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Pays : {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Distance : {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping : {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Test du débit descendant…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Débit descendant : {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Test du débit montant…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Débit montant : {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Débit descendant recommandé pour le streaming vidéo :[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3 à 5 Mbps pour la vidéo SD 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5 à 10 Mbps pour la vidéo HD 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps pour un 1080p optimal ou la TV en direct"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25 à 50+ Mbps pour le streaming 4K"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Les débits mesurés peuvent dépendre des limites de l'appareil.[/I]"
