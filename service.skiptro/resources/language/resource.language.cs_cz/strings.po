msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Tlačítko pro přeskočení úvodu/titulků"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Během úvodu a závěrečných titulků zobrazí tlačítko pro přeskočení. Načítá časové údaje ze souborů .skiptro.json uložených vedle videosouborů."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialogové okno"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automaticky zavřít dialog po (sekundách)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automaticky přeskakovat úvody"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Přeskočit úvod"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Přeskočit titulky"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Přejít na scénu po titulcích"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nelze načíst data pro přeskočení. Zkontrolujte oprávnění k souborům."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nelze načíst data pro přeskočení. V nastavení Androidu zapněte pro Kodi „Přístup ke všem souborům“."
