msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Knop om intro/aftiteling over te slaan"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Toont een knop om de intro en de aftiteling over te slaan. Leest tijdsgegevens uit .skiptro.json-bestanden naast de videobestanden."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialoogvenster"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Dialoogvenster automatisch sluiten na (seconden)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Intro's automatisch overslaan"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Intro overslaan"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Aftiteling overslaan"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Naar scène na aftiteling"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Kan overslaggegevens niet lezen. Controleer de bestandsrechten."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Kan overslaggegevens niet lezen. Zet “Toegang tot alle bestanden” aan voor Kodi in de Android-instellingen."
