msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Intron ja lopputekstien ohituspainike"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Näyttää ohituspainikkeen intron ja lopputekstien aikana. Lukee ajoitustiedot videotiedostojen vieressä olevista .skiptro.json-tiedostoista."

msgctxt "#32001"
msgid "Dialog"
msgstr "Valintaikkuna"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Sulje valintaikkuna automaattisesti (sekunnin kuluttua)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Ohita introt automaattisesti"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Ohita intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Ohita lopputekstit"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Siirry bonuskohtaukseen"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Ohitustietoja ei voi lukea. Tarkista tiedostojen käyttöoikeudet."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Ohitustietoja ei voi lukea. Ota Androidin asetuksista käyttöön ”Pääsy kaikkiin tiedostoihin” Kodille."
