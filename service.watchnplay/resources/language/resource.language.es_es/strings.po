msgid "Code expired, getting a new one…"
msgstr "El código ha caducado, obteniendo uno nuevo…"

msgctxt "#32016"
msgid "Too many attempts. Please try again later."
msgstr "Demasiados intentos. Inténtalo de nuevo más tarde."

