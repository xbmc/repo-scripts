msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Knapp för att hoppa över intro/eftertexter"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Visar en knapp för att hoppa över intro och eftertexter. Läser tidsdata från .skiptro.json-filer som ligger bredvid videofilerna."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialogruta"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Stäng dialogrutan automatiskt efter (sekunder)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Hoppa över intron automatiskt"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Hoppa över intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Hoppa över eftertexter"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Hoppa till extrascenen"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Kan inte läsa data för överhoppning. Kontrollera filbehörigheterna."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Kan inte läsa data för överhoppning. Aktivera ”Åtkomst till alla filer” för Kodi i Android-inställningarna."
