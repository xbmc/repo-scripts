#. Settings group - language for data from online APIs (TMDb titles, plots, etc.)
msgctxt "#32976"
msgid "Online Service"
msgstr "Online služba"

msgctxt "#32977"
msgid "Language for online metadata from TMDb, Last.fm, and TheAudioDB"
msgstr "Jazyk online metadat z TMDb, Last.fm a TheAudioDB"

#. Actor image download feature (context menu)
msgctxt "#32981"
msgid "Downloading actor images..."
msgstr "Stahování obrázků herců..."

msgctxt "#32982"
msgid "{0} actors"
msgstr "Herci: {0}"

msgctxt "#32983"
msgid "Include TV Episode Guest Stars"
msgstr "Zahrnout hostující hvězdy epizod seriálů"

msgctxt "#32984"
msgid "Download guest star images from TV show episodes (increases API calls)"
msgstr "Stahovat obrázky hostujících hvězd z epizod seriálů (zvyšuje počet volání API)"

msgctxt "#32985"
msgid "Include Episode Thumbnails"
msgstr "Zahrnout miniatury epizod"

msgctxt "#32986"
msgid "Download episode thumbnail artwork during bulk operations"
msgstr "Při hromadných operacích stahovat grafiku miniatur epizod"

msgctxt "#32987"
msgid "Text too long to fully display"
msgstr "Text je příliš dlouhý pro úplné zobrazení"

msgctxt "#32988"
msgid "Sync TV Show Metadata"
msgstr "Synchronizovat metadata seriálů"

msgctxt "#32989"
msgid "Updates online metadata for every TV show in your library. Large libraries may take significantly longer."
msgstr "Aktualizuje online metadata všech seriálů v knihovně. U rozsáhlých knihoven to může trvat podstatně déle."

msgctxt "#32990"
msgid "Fetching {0:d} of {1:d}"
msgstr "Načítání {0:d} z {1:d}"

msgctxt "#32991"
msgid "Updated: {0:d}[CR]Skipped: {1:d}[CR]Failed: {2:d}"
msgstr "Aktualizováno: {0:d}[CR]Přeskočeno: {1:d}[CR]Neúspěšné: {2:d}"

msgctxt "#32992"
msgid "Library Maintenance"
msgstr "Údržba knihovny"

msgctxt "#32993"
msgid "NFO Files"
msgstr "Soubory NFO"

msgctxt "#32994"
msgid "Write metadata changes to NFO files"
msgstr "Zapsat změny metadat do souborů NFO"

msgctxt "#32995"
msgid "When you edit metadata, also write the change to the item's local NFO file so it survives a library refresh or rescrape."
msgstr "Při úpravě metadat zapsat změnu také do místního souboru NFO položky, aby se zachovala po obnovení knihovny nebo opětovném načtení metadat."

msgctxt "#32996"
msgid "Create an NFO file when none exists"
msgstr "Vytvořit soubor NFO, pokud žádný neexistuje"

msgctxt "#32997"
msgid "If the item has no NFO file yet, create one. When off, only existing NFO files are updated."
msgstr "Pokud položka dosud nemá soubor NFO, vytvořit jej. Je-li tato možnost vypnuta, aktualizují se pouze existující soubory NFO."

msgctxt "#32998"
msgid "Include watched state in NFO files"
msgstr "Zahrnout stav zhlédnutí do souborů NFO"

msgctxt "#32999"
msgid "Write playcount and last-played date to NFO files. Turn off to keep watched state out of your NFO files."
msgstr "Zapisovat počet přehrání a datum posledního přehrání do souborů NFO. Vypněte, chcete-li stav zhlédnutí ze souborů NFO vynechat."

