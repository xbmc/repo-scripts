msgctxt "#30000"
msgid "Connection"
msgstr "Connexion"

msgctxt "#30001"
msgid "Seenr connection URL"
msgstr "URL de connexion Seenr"

msgctxt "#30002"
msgid "Copy it from Seenr: Account, Auto-tracking, Kodi. It contains your private token, so treat it like a password."
msgstr "À copier depuis Seenr : Compte, Auto-suivi, Kodi. Elle contient ton jeton privé : garde-la comme un mot de passe."

msgctxt "#30003"
msgid "Notify when a title is sent"
msgstr "Prévenir quand un titre part"

msgctxt "#30004"
msgid "Shows a short toast once a movie or episode has been reported to Seenr."
msgstr "Affiche une notification brève quand un film ou un épisode a été signalé à Seenr."

msgctxt "#30010"
msgid "Seenr refused the connection. Generate a new URL in your settings."
msgstr "Seenr a refusé la connexion. Génère une nouvelle URL dans tes réglages."

msgctxt "#30011"
msgid "Sent to Seenr"
msgstr "Envoyé à Seenr"
