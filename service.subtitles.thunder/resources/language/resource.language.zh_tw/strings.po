msgctxt "#32001"
msgid "Text subtitles save as UTF-8"
msgstr "文本字幕保存爲UTF-8編碼"

msgctxt "#32002"
msgid "Simplified and Traditional conversion"
msgstr "文本字幕簡繁轉換"

msgctxt "#32003"
msgid "disable"
msgstr "禁用"

msgctxt "#32004"
msgid "Simplified"
msgstr "簡體"

msgctxt "#32005"
msgid "Traditional"
msgstr "繁體"

msgctxt "#32006"
msgid "Choose subtitle file"
msgstr "請選擇要使用的字幕文件"

msgctxt "#32010"
msgid "No subtitles found"
msgstr "沒有找到匹配的字幕"

msgctxt "#32011"
msgid "Search subtitles by name"
msgstr "輸入片名搜尋字幕（可加年份）"

msgctxt "#32012"
msgid "Subtitle operation failed. See the Kodi log."
msgstr "字幕操作失敗，請查看 Kodi 日誌"

msgctxt "#32013"
msgid "Cannot read or seek the playing file"
msgstr "無法讀取或定位目前播放檔案"

msgctxt "#32014"
msgid "Thunder service unavailable. Please try again later."
msgstr "迅雷字幕服務暫時無法使用，請稍後重試"

msgctxt "#32015"
msgid "Cannot download subtitle (invalid file, unsupported archive or size limit)"
msgstr "字幕下載失敗：檔案無效、壓縮格式不支援或超出大小限制"

msgctxt "#32016"
msgid "Cannot decode subtitle; disable UTF-8 conversion to keep the original"
msgstr "無法辨識字幕編碼，可關閉 UTF-8 轉換保留原始檔案"

