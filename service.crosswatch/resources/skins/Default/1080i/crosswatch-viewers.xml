                <texturesliderbarfocus colordiffuse="FF7C5CFF">crosswatch/white.png</texturesliderbarfocus>
                <textureslidernib></textureslidernib>
                <textureslidernibfocus></textureslidernibfocus>
                <onleft>100</onleft>
            </control>
            <!-- The panel reads the highlighted row's properties, so Kodi redraws it as focus moves. -->
            <control type="label">
                <left>530</left><top>110</top><width>660</width><height>50</height>
                <aligny>center</aligny>
                <font>font32_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <label>$INFO[Container(100).ListItem.Label]</label>
