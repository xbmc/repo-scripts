msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Интро/титр алгасах товч"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Интро болон төгсгөлийн титрийн үед алгасах товч харуулна. Видео файлын хажууд байрлах .skiptro.json файлаас хугацааны мэдээллийг уншина."

msgctxt "#32001"
msgid "Dialog"
msgstr "Харилцах цонх"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Цонхыг автоматаар хаах хугацаа (секунд)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Интрог автоматаар алгасах"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Интро алгасах"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Титр алгасах"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Титрийн дараах хэсэг рүү шилжих"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Алгасах өгөгдлийг уншиж чадсангүй. Файлын зөвшөөрлийг шалгана уу."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Алгасах өгөгдлийг уншиж чадсангүй. Андройдын тохиргоонд Kodi програмд «Бүх файлд хандах» зөвшөөрлийг идэвхжүүлнэ үү."
