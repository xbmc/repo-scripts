msgctxt "#30055"
msgid "Next episode in [COLOR FFFF4081]$INFO[Window.Property(remaining_time)][/COLOR]"
msgstr "将在 [COLOR FFFF4081]$INFO[Window.Property(remaining_time)][/COLOR] 后播放下一集"

msgctxt "#30056"
msgid "Continue watching in [COLOR FFFF4081]$INFO[Window.Property(remaining_time)][/COLOR]"
msgstr "将在 [COLOR FFFF4081]$INFO[Window.Property(remaining_time)][/COLOR] 后继续观看"

msgctxt "#30057"
msgid "Now finishing"
msgstr "即将播完"

msgctxt "#30060"
msgid "[B]UP NEXT DEMO MODE ENABLED[/B]"
msgstr "[B]“下个播放”演示模式已开启[/B]"

msgctxt "#30061"
