msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Scrobbler Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Scrobbler wysyła informacje o utworach, których słuchasz, do serwisu Last.fm"

msgctxt "#30000"
msgid "General"
msgstr "Ogólne"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Publikuj odtwarzane utwory w serwisie Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Publikuj radio internetowe w serwisie Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Nazwa użytkownika Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Hasło Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Potwierdź zgłoszenia Ulubionych/Zablokowanych"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Publikuj teledyski w serwisie Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Zaawansowane"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Włącz logowanie"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "W przypadku wielu wykonawców użyj tylko pierwszego"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Czy chcesz dodać ten utwór do ulubionych?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Dodano do ulubionych: „%s”."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Nie mogę dodać '%s' do twoich ulubionych ścieżek."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Połączenie z Last.fm nie powiodło się"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Nie podano nazwy użytkownika lub hasła"
