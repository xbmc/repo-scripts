msgid "[B]Run Speedtest[/B]"
msgstr "[B]Avvia test di velocità[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Chiudi[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Attendere…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Add-on test di velocità in esecuzione[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Recupero della configurazione di speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Recupero dell'elenco dei server di speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Test da {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Selezione del server migliore in base alla latenza"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Ospitato da: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Server host: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Città: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Paese: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Distanza: {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping: {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Test velocità di download…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Velocità di download: {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Test velocità di upload…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Velocità di upload: {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Velocità di download consigliata per lo streaming video:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- da 3 a 5 Mbps per video SD 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- da 5 a 10 Mbps per video HD 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps per il miglior 1080p o TV in diretta"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- da 25 a 50+ Mbps per lo streaming 4K"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Le velocità riportate possono dipendere dai limiti del dispositivo.[/I]"
