msgstr "Verbindung entfernt. Du kannst dich in den Add-on-Einstellungen neu verbinden."

msgctxt "#32019"
msgid "WatchNPlay Pro is needed to keep syncing."
msgstr "Zum Weitersynchronisieren brauchst du WatchNPlay Pro."

msgctxt "#32020"
msgid "Disconnected from WatchNPlay."
msgstr "Von WatchNPlay getrennt."

msgctxt "#32021"
msgid "Disconnect this device from WatchNPlay?"
msgstr "Dieses Gerät von WatchNPlay trennen?"

msgctxt "#32022"
msgid "Sync started."
msgstr "Synchronisierung gestartet."

msgctxt "#32024"
msgid "Requesting code…"
msgstr "Code wird angefordert …"

msgctxt "#32025"
msgid "Device"
msgstr "Gerät"
