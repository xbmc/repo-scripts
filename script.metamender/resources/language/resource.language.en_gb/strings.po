msgctxt "#32390"
msgid "Text source order"
msgstr ""

msgctxt "#32391"
msgid "Which provider to ask first for TV show plots and episode titles and plots in the source folder's language. If the first has nothing, the second is asked. \"Follow your scraper\" asks first the provider whose Kodi scraper added the show or episode, so its wording stays; TMDB first when that cannot be told. Movies always use TMDB."
msgstr ""

msgctxt "#32392"
msgid "TMDB, then TheTVDB"
msgstr ""

msgctxt "#32393"
msgid "TheTVDB, then TMDB"
msgstr ""

