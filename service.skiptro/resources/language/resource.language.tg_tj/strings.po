msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Тугмаи гузаштан аз муқаддима/титрҳо"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Ҳангоми муқаддима ва титрҳои охир тугмаи гузаштанро нишон медиҳад. Маълумоти вақтро аз файлҳои .skiptro.json, ки дар паҳлӯи файлҳои видео ҷойгиранд, мехонад."

msgctxt "#32001"
msgid "Dialog"
msgstr "Равзанаи муколама"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Пӯшидани худкори равзана баъд аз (сония)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Гузаштани худкор аз муқаддимаҳо"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Гузаштан аз муқаддима"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Гузаштан аз титрҳо"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Гузариш ба саҳнаи пас аз титрҳо"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Маълумоти гузаштанро хондан ғайриимкон аст. Иҷозатҳои файлро санҷед."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Маълумоти гузаштанро хондан ғайриимкон аст. Дар танзимоти Android барои Kodi «Дастрасӣ ба ҳамаи файлҳо»-ро фаъол кунед."
