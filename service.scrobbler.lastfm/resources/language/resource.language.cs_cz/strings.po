msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Scrobbler pro Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Scrobbler Last.fm odesílá na Last.fm informace o skladbách, které posloucháte v Kodi."

msgctxt "#30000"
msgid "General"
msgstr "Obecné"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Odesílat skladby na Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Odesílat údaje o poslechu internetového rádia na Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Uživatelské jméno Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Heslo Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Potvrzovat označení skladby jako oblíbené"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Odesílat hudební videa na Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Pokročilé"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Povolit protokolování"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "V případě více interpretů použít pouze prvního"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Chcete přidat aktuální skladbu mezi oblíbené skladby?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Přidáno mezi oblíbené skladby: „%s“."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Skladbu „%s“ se nepodařilo přidat mezi oblíbené skladby."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Připojení k Last.fm selhalo"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Není zadáno uživatelské jméno nebo heslo"
