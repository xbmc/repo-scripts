msgid "Server selection"
msgstr "Wybór serwera"

msgctxt "#30902"
msgid "Server selection"
msgstr "Wybór serwera"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Wybierz sposób wyboru serwera testowego."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automatycznie (najbliższy)"

msgctxt "#30905"
msgid "By location"
msgstr "Według lokalizacji"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "Określone ID serwera"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Lokalizacja (miasto lub kraj)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Szukaj serwerów w określonym mieście lub kraju."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID serwera"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Zawsze testuj z tym ID serwera speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Preferuj serwery HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Używaj tylko serwerów obsługujących bezpieczne połączenia HTTPS."

msgctxt "#30920"
msgid "Test"
msgstr "Test"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Testuj prędkość wysyłania"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Wyłącz, aby wykonać test tylko pobierania."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Wyślij wyniki do speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Prześlij wynik do speedtest.net i pokaż obraz wyniku."

msgctxt "#30930"
msgid "Advanced"
msgstr "Zaawansowane"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Limit czasu połączenia (sekundy)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Limit czasu sieci dla każdego żądania."

msgctxt "#30933"
msgid "Log level"
msgstr "Poziom logowania"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Ilość szczegółów zapisywanych w dzienniku Kodi."

msgctxt "#30935"
msgid "Quiet"
msgstr "Cichy"

msgctxt "#30936"
msgid "Info"
msgstr "Info"

msgctxt "#30937"
msgid "Verbose"
msgstr "Szczegółowy"

msgctxt "#30938"
msgid "Debug"
msgstr "Debug"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]Uruchom test prędkości[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Zamknij[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Proszę czekać…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Trwa działanie dodatku testu prędkości[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Pobieranie konfiguracji speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Pobieranie listy serwerów speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Test z {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Wybieranie najlepszego serwera na podstawie opóźnienia"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Host: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Serwer: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Miasto: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Kraj: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Odległość: {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping: {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Testowanie prędkości pobierania…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Prędkość pobierania: {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Testowanie prędkości wysyłania…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Prędkość wysyłania: {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Zalecana prędkość pobierania do strumieniowania wideo:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3 do 5 Mbps dla wideo SD 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5 do 10 Mbps dla wideo HD 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps dla najlepszego 1080p lub telewizji na żywo"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25 do 50+ Mbps dla strumieniowania 4K"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Wyświetlane prędkości mogą zależeć od ograniczeń urządzenia.[/I]"
