msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Knap til at springe intro/rulletekster over"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Viser en knap til at springe over under intro og rulletekster. Læser tidsdata fra .skiptro.json-filer ved siden af videofilerne."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Luk dialog automatisk efter (sekunder)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Spring automatisk introer over"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Spring intro over"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Spring rulletekster over"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Gå til ekstrascene"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Kan ikke læse overspringsdata. Kontrollér filtilladelserne."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Kan ikke læse overspringsdata. Slå »Adgang til alle filer« til for Kodi i Android-indstillingerne."
