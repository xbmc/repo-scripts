msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Intró és stáblista átugrása gomb"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Átugrás gombot jelenít meg az intró és a stáblista alatt. Az időzítési adatokat a videofájlok mellett található .skiptro.json fájlokból olvassa be."

msgctxt "#32001"
msgid "Dialog"
msgstr "Párbeszédablak"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Párbeszédablak automatikus bezárása (másodperc)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Intrók automatikus átugrása"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Intró átugrása"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Stáblista átugrása"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Ugrás a stáblista utáni jelenetre"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nem olvashatók az átugrási adatok. Ellenőrizze a fájl jogosultságait."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nem olvashatók az átugrási adatok. Kapcsolja be a Kodi számára a „Hozzáférés az összes fájlhoz” engedélyt az Android beállításaiban."
