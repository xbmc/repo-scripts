<?xml version="1.0" encoding="UTF-8"?>
<!-- Every control is inline: Kodi resolves includes and named colours from the active skin only, never from a script's own skin folder. Fonts are anchor names that skin_fonts.py maps onto the active skin. -->
<window>
    <zorder>1</zorder>
    <!-- Not the show list: it is empty until onInit fills it, so Kodi cannot focus it when the window opens and logs an error. onInit moves focus to it. -->
    <defaultcontrol always="true">21</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6090A0D">crosswatch/white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        </control>
        <control type="group">
            <left>340</left><top>110</top><width>1240</width><height>860</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="300" delay="100"/>
                <effect type="zoom" start="96" end="100" center="auto" tween="sine" easing="out" time="300" delay="100"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="zoom" start="100" end="96" center="auto" tween="sine" easing="out" time="200"/>
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="200"/>
            </animation>
            <control type="image">
                <left>0</left><top>0</top><width>1240</width><height>860</height>
                <texture border="28">crosswatch/panel.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1240</width><height>6</height>
                <texture>crosswatch/gradient.png</texture>
            </control>
            <control type="label">
                <left>50</left><top>40</top><width>220</width><height>50</height>
                <aligny>center</aligny>
                <font>font25_title</font>
                <textcolor>FF9299A6</textcolor>
                <label>CROSSWATCH</label>
            </control>
            <!-- Centred on the panel, between the brand and the count; a long heading is cut at
                 this width rather than running into either. -->
            <control type="label">
                <left>270</left><top>40</top><width>700</width><height>50</height>
                <align>center</align><aligny>center</aligny>
                <font>font32_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <label>$INFO[Window.Property(CW.Heading)]</label>
            </control>
            <control type="label">
                <left>990</left><top>40</top><width>200</width><height>50</height>
                <align>right</align><aligny>center</aligny>
                <font>font13</font>
                <textcolor>FF9299A6</textcolor>
                <label>$INFO[Window.Property(CW.Count)]</label>
            </control>
            <control type="edit" id="30">
                <left>50</left><top>110</top><width>560</width><height>72</height>
                <!-- Explicit: a skin's own default for edit controls applies here otherwise. -->
                <align>left</align><aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <font>font30_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <focusedcolor>FFF1F3F5</focusedcolor>
                <label></label>
                <!-- Kodi draws the hint in the text colour; the colour tag mutes it. -->
                <hinttext>[COLOR FF9299A6]$ADDON[service.crosswatch 30086][/COLOR]</hinttext>
                <texturenofocus border="16">crosswatch/box.png</texturenofocus>
                <texturefocus border="16">crosswatch/box_focus.png</texturefocus>
                <ondown>100</ondown>
            </control>
            <control type="label">
                <left>50</left><top>206</top><width>1140</width><height>66</height>
                <aligny>center</aligny>
                <font>font13</font>
                <textcolor>FF9299A6</textcolor>
                <label>$ADDON[service.crosswatch 30089]</label>
                <visible>String.IsEqual(Window.Property(CW.Empty),true)</visible>
            </control>
            <control type="list" id="100">
                <left>50</left><top>206</top><width>1140</width><height>456</height>
                <orientation>vertical</orientation>
                <scrolltime>0</scrolltime>
                <pagecontrol>101</pagecontrol>
                <onup>30</onup>
                <ondown>22</ondown>
                <itemlayout width="1140" height="76">
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box.png</texture>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box_chosen.png</texture>
                        <visible>String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="label">
                        <left>28</left><top>0</top><width>640</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font30_title</font>
                        <textcolor>FFF1F3F5</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>684</left><top>0</top><width>240</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font13</font>
                        <textcolor>FF9299A6</textcolor>
                        <label>$INFO[ListItem.Property(detail)]</label>
                    </control>
                    <control type="label">
                        <left>940</left><top>0</top><width>116</width><height>66</height>
                        <align>right</align><aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>FF9299A6</textcolor>
                        <label>$INFO[ListItem.Property(tag)]</label>
                    </control>
                    <control type="image">
                        <left>1072</left><top>9</top><width>48</width><height>48</height>
                        <texture>crosswatch/tick.png</texture>
                        <visible>String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="1140" height="76">
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box.png</texture>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box_chosen.png</texture>
                        <visible>String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box_focus.png</texture>
                        <visible>Control.HasFocus(100) + !String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>1140</width><height>66</height>
                        <texture border="16">crosswatch/box_chosen_focus.png</texture>
                        <visible>Control.HasFocus(100) + String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="label">
                        <left>28</left><top>0</top><width>640</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font30_title</font>
                        <textcolor>FFF1F3F5</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>684</left><top>0</top><width>240</width><height>66</height>
                        <aligny>center</aligny>
                        <font>font13</font>
                        <textcolor>FF9299A6</textcolor>
                        <label>$INFO[ListItem.Property(detail)]</label>
                    </control>
                    <control type="label">
                        <left>940</left><top>0</top><width>116</width><height>66</height>
                        <align>right</align><aligny>center</aligny>
                        <font>font12</font>
                        <textcolor>FF9299A6</textcolor>
                        <label>$INFO[ListItem.Property(tag)]</label>
                    </control>
                    <control type="image">
                        <left>1072</left><top>9</top><width>48</width><height>48</height>
                        <texture>crosswatch/tick.png</texture>
                        <visible>String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                </focusedlayout>
            </control>
            <control type="scrollbar" id="101">
                <left>1196</left><top>206</top><width>6</width><height>446</height>
                <orientation>vertical</orientation>
                <showonepage>false</showonepage>
                <texturesliderbackground colordiffuse="FF1C222C">crosswatch/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="FF7C5CFF">crosswatch/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FF7C5CFF">crosswatch/white.png</texturesliderbarfocus>
                <textureslidernib></textureslidernib>
                <textureslidernibfocus></textureslidernibfocus>
                <onleft>100</onleft>
            </control>
            <control type="button" id="22">
                <left>50</left><top>740</top><width>170</width><height>72</height>
                <align>center</align><aligny>center</aligny>
                <textoffsetx>10</textoffsetx>
                <font>font30_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <focusedcolor>FFF1F3F5</focusedcolor>
                <pulseonselect>false</pulseonselect>
                <label>$ADDON[service.crosswatch 30082]</label>
                <texturenofocus border="16">crosswatch/box_accent.png</texturenofocus>
                <texturefocus border="16">crosswatch/box_accent_focus.png</texturefocus>
                <onup>100</onup>
                <onright>23</onright>
            </control>
            <control type="button" id="23">
                <left>470</left><top>740</top><width>300</width><height>72</height>
                <align>center</align><aligny>center</aligny>
                <textoffsetx>10</textoffsetx>
                <font>font30_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <focusedcolor>FFF1F3F5</focusedcolor>
                <pulseonselect>false</pulseonselect>
                <label>$INFO[Window.Property(CW.Extra)]</label>
                <visible>!String.IsEmpty(Window.Property(CW.Extra))</visible>
                <texturenofocus border="16">crosswatch/box.png</texturenofocus>
                <texturefocus border="16">crosswatch/box_focus.png</texturefocus>
                <onup>100</onup>
                <onleft>22</onleft>
                <onright>21</onright>
            </control>
            <control type="button" id="21">
                <left>1020</left><top>740</top><width>170</width><height>72</height>
                <align>center</align><aligny>center</aligny>
                <textoffsetx>10</textoffsetx>
                <font>font30_title</font>
                <textcolor>FFF1F3F5</textcolor>
                <focusedcolor>FFF1F3F5</focusedcolor>
                <pulseonselect>false</pulseonselect>
                <label>$INFO[Window.Property(CW.Close)]</label>
                <texturenofocus border="16">crosswatch/box.png</texturenofocus>
                <texturefocus border="16">crosswatch/box_focus.png</texturefocus>
                <onup>100</onup>
                <onleft>23</onleft>
            </control>
        </control>
    </controls>
</window>
