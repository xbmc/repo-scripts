msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Скробблер Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Скробблер Last.fm отправит информацию о песнях, которые вы слушали в Kodi, на last.fm"

msgctxt "#30000"
msgid "General"
msgstr "Общие"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Отправлять статистику на Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Отправить потоковое радио на Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Имя пользователя для Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Пароль для Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Подтвердить любимые заявки"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Отправить музыкальные видео на Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Расширенные"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Включить ведение журнала"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "В случае, когда нескольких исполнителей, использовать только первого"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Добавить этот трек в любимые?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Добавлено к вашим любимым трекам: \"%s\"."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Не удалось добавить \"%s\" к любимым трекам."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Подключение к Last.fm не удалось"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Имя пользователя и пароль не заданы"
