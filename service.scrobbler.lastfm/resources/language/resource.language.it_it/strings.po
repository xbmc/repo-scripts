msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Scrobbler di Last.fm"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Lo scrobbler di Last.fm invierà a last.fm le informazioni sui brani che hai ascoltato in Kodi"

msgctxt "#30000"
msgid "General"
msgstr "Generale"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Invia brani a Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Invia radio in streaming a Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Nome utente Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Password Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Conferma aggiungi/rimuovi dai preferiti"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Invia video musicali a Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Avanzato"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Abilita registrazione eventi"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "In caso di più artisti, usa solo il primo"

# empty strings from id 300010 to 32010
msgctxt "#32011"
msgid "Last.fm"
msgstr "Last.fm"

msgctxt "#32012"
msgid "Do you want to add the current track to your loved tracks?"
msgstr "Vuoi aggiungere il brano attuale ai tuoi brani preferiti?"

# empty string with id 32013
msgctxt "#32014"
msgid "Added to your loved tracks: '%s'."
msgstr "Aggiunto ai tuoi brani preferiti: '%s'."

msgctxt "#32015"
msgid "Could not add '%s' to your loved tracks."
msgstr "Impossibile aggiungere '%s' ai tuoi brani preferiti."

# empty strings from id 32016 to 32025
msgctxt "#32026"
msgid "Connect to Last.fm failed"
msgstr "Connessione a Last.fm non riuscita"

msgctxt "#32027"
msgid "No username or password provided"
msgstr "Nessun nome utente o password forniti"
