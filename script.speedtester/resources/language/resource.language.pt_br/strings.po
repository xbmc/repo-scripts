msgstr "Tempo limite de conexão (segundos)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Tempo limite de rede para cada requisição."

msgctxt "#30933"
msgid "Log level"
msgstr "Nível de log"

