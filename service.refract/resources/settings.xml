<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.refract">
    <category id="account" label="32001">
      <group id="1">
        <setting id="account_name" type="string" label="32002">
          <level>0</level>
          <default/>
          <enable>false</enable>
          <control type="edit" format="string"/>
        </setting>
        <setting id="connect" type="action" label="32003">
          <level>0</level>
          <data>RunScript(service.refract,connect)</data>
          <control type="button" format="action"/>
        </setting>
        <setting id="disconnect" type="action" label="32004">
          <level>0</level>
          <data>RunScript(service.refract,disconnect)</data>
          <control type="button" format="action"/>
