msgctxt "#32000"
msgid "Account"
msgstr "Konto"

msgctxt "#32001"
msgid "Status"
msgstr "Status"

msgctxt "#32002"
msgid "Connect with WatchNPlay"
msgstr "Koble til WatchNPlay"

msgctxt "#32003"
msgid "Disconnect"
msgstr "Koble fra"

msgctxt "#32004"
msgid "Sync now"
msgstr "Synkroniser nå"

msgctxt "#32005"
msgid "Not connected"
msgstr "Ikke tilkoblet"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Tilkoblet som %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "Satt på pause: WatchNPlay Pro kreves"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "API-adresse (kun for testing)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Skann QR-koden med mobilen, eller åpne Data og synk › Kodi i appen og skriv inn denne koden:"

msgctxt "#32011"
msgid "Without the app: %s"
msgstr "Uten appen: %s"

msgctxt "#32012"
msgid "Code valid for %s"
msgstr "Koden er gyldig i %s"

msgctxt "#32013"
msgid "Cancel"
msgstr "Avbryt"

msgctxt "#32014"
msgid "Connected with %s"
msgstr "Tilkoblet %s"

msgctxt "#32015"
msgid "Code expired, getting a new one…"
msgstr "Koden er utløpt, henter en ny…"

msgctxt "#32016"
msgid "Too many attempts. Please try again later."
msgstr "For mange forsøk. Prøv igjen senere."

msgctxt "#32017"
msgid "WatchNPlay cannot be reached. Please check your internet connection."
msgstr "Får ikke kontakt med WatchNPlay. Sjekk internettforbindelsen."

msgctxt "#32018"
msgid "Connection removed. You can connect again in the add-on settings."
msgstr "Tilkoblingen er fjernet. Du kan koble til på nytt i tilleggets innstillinger."

msgctxt "#32019"
msgid "WatchNPlay Pro is needed to keep syncing."
msgstr "Du trenger WatchNPlay Pro for å fortsette synkroniseringen."

msgctxt "#32020"
msgid "Disconnected from WatchNPlay."
msgstr "Koblet fra WatchNPlay."

msgctxt "#32021"
msgid "Disconnect this device from WatchNPlay?"
msgstr "Koble denne enheten fra WatchNPlay?"

msgctxt "#32022"
msgid "Sync started."
msgstr "Synkroniseringen har startet."

msgctxt "#32024"
msgid "Requesting code…"
msgstr "Ber om kode…"

msgctxt "#32025"
msgid "Device"
msgstr "Enhet"
