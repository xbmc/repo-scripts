msgctxt "#30900"
msgid "Server"
msgstr "Server"

msgctxt "#30901"
msgid "Server selection"
msgstr "Serverauswahl"

msgctxt "#30902"
msgid "Server selection"
msgstr "Serverauswahl"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Legt fest, wie der Testserver ausgewählt wird."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automatisch (nächstgelegener)"

msgctxt "#30905"
msgid "By location"
msgstr "Nach Standort"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "Bestimmte Server-ID"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Standort (Stadt oder Land)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Nach Servern in einer bestimmten Stadt oder einem Land suchen."

msgctxt "#30909"
msgid "Server ID"
msgstr "Server-ID"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Immer gegen diese speedtest.net-Server-ID testen."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "HTTPS-Server bevorzugen"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Nur Server verwenden, die sichere HTTPS-Verbindungen unterstützen."

