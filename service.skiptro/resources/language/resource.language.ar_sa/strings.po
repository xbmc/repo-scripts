msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "زر لتخطي المقدمة/شارة النهاية"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "يعرض زر تخطٍّ أثناء المقدمة وشارة النهاية. يقرأ بيانات التوقيت من ملفات .skiptro.json الموجودة بجانب ملفات الفيديو."

msgctxt "#32001"
msgid "Dialog"
msgstr "مربع الحوار"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "إغلاق مربع الحوار تلقائيًا بعد (ثوانٍ)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "تخطي المقدمات تلقائيًا"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "تخطي المقدمة"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "تخطي شارة النهاية"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "الانتقال إلى مشهد ما بعد الشارة"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "تعذّرت قراءة بيانات التخطي. تحقق من أذونات الملف."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "تعذّرت قراءة بيانات التخطي. فعّل «الوصول إلى كل الملفات» لتطبيق Kodi في إعدادات Android."
