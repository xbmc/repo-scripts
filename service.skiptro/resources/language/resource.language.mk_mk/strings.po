msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Копче за прескокнување на вовед/одјавна шпица"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Прикажува копче за прескокнување за време на воведот и одјавната шпица. Ги чита податоците за времето од датотеките .skiptro.json покрај видео датотеките."

msgctxt "#32001"
msgid "Dialog"
msgstr "Дијалог"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Автоматско затворање на дијалогот по (секунди)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Автоматско прескокнување на воведите"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Прескокни вовед"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Прескокни шпица"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Скокни до сцената по шпицата"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Не може да се прочитаат податоците за прескокнување. Проверете ги дозволите на датотеката."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Не може да се прочитаат податоците за прескокнување. Вклучете „Пристап до сите датотеки“ за Kodi во поставките на Android."
