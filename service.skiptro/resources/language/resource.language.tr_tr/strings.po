msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Giriş/jenerik atlama düğmesi"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Giriş ve jenerik bölümlerinde bir atlama düğmesi gösterir. Zamanlama verilerini video dosyalarının yanındaki .skiptro.json dosyalarından okur."

msgctxt "#32001"
msgid "Dialog"
msgstr "İletişim kutusu"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "İletişim kutusunu otomatik kapatma süresi (saniye)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Girişleri otomatik atla"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Girişi atla"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Jeneriği atla"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Jenerik sonrası sahneye geç"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Atlama verileri okunamıyor. Dosya izinlerini kontrol edin."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Atlama verileri okunamıyor. Android ayarlarında Kodi için “Tüm dosyalara erişim” iznini açın."
