msgid "Connect with WatchNPlay"
msgstr "Mit WatchNPlay verbinden"

msgctxt "#32003"
msgid "Disconnect"
msgstr "Trennen"

msgctxt "#32004"
msgid "Sync now"
msgstr "Jetzt synchronisieren"

msgctxt "#32005"
msgid "Not connected"
msgstr "Nicht verbunden"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Verbunden als %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "Pausiert: WatchNPlay Pro nötig"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "API-Adresse (nur zum Testen)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Scanne den QR-Code mit deinem Handy oder öffne in der App Daten & Sync › Kodi und gib diesen Code ein:"

msgctxt "#32011"
msgid "Without the app: %s"
msgstr "Ohne App: %s"

msgctxt "#32012"
msgid "Code valid for %s"
msgstr "Code gültig für %s"

msgctxt "#32013"
msgid "Cancel"
msgstr "Abbrechen"

