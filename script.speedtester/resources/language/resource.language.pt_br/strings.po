msgctxt "#30900"
msgid "Server"
msgstr "Servidor"

msgctxt "#30901"
msgid "Server selection"
msgstr "Seleção de servidor"

msgctxt "#30902"
msgid "Server selection"
msgstr "Seleção de servidor"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Escolha como o servidor de teste é selecionado."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automático (mais próximo)"

msgctxt "#30905"
msgid "By location"
msgstr "Por localização"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "ID de servidor específico"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Localização (cidade ou país)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Buscar servidores em uma cidade ou país específico."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID do servidor"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Sempre testar com este ID de servidor do speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Preferir servidores HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Usar apenas servidores que suportam conexões HTTPS seguras."

msgctxt "#30920"
msgid "Test"
msgstr "Teste"

msgctxt "#30921"
