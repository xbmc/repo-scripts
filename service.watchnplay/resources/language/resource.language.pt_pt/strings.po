msgstr "Ligar ao WatchNPlay"

msgctxt "#32003"
msgid "Disconnect"
msgstr "Desligar"

msgctxt "#32004"
msgid "Sync now"
msgstr "Sincronizar agora"

msgctxt "#32005"
msgid "Not connected"
msgstr "Não ligado"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Ligado como %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "Em pausa: é necessário o WatchNPlay Pro"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "Endereço da API (apenas para testes)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Leia o código QR com o telemóvel ou abra Dados e sincronização › Kodi na app e introduza este código:"

