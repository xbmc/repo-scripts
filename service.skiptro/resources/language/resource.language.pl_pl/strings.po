msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Przycisk pomijania czołówki/napisów końcowych"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Wyświetla przycisk pomijania podczas czołówki i napisów końcowych. Odczytuje dane o czasie z plików .skiptro.json umieszczonych obok plików wideo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Okno dialogowe"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Automatyczne zamykanie okna po (sekundy)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Automatycznie pomijaj czołówki"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Pomiń czołówkę"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Pomiń napisy końcowe"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Przejdź do sceny po napisach"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Nie można odczytać danych pomijania. Sprawdź uprawnienia pliku."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Nie można odczytać danych pomijania. Włącz „Dostęp do wszystkich plików” dla Kodi w ustawieniach Androida."
