msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Knoppie om intro/aftiteling oor te slaan"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Wys 'n oorslaanknoppie tydens die intro en aftiteling. Lees tydsdata uit .skiptro.json-lêers langs die videolêers."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialoog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Sluit dialoog outomaties na (sekondes)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Slaan intro's outomaties oor"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Slaan intro oor"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Slaan aftiteling oor"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Spring na ekstra toneel"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Kan nie oorslaandata lees nie. Kontroleer die lêertoestemmings."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Kan nie oorslaandata lees nie. Skakel “Toegang tot alle lêers” vir Kodi aan in die Android-instellings."
