msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Botão para saltar a introdução/genérico"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Mostra um botão para saltar durante a introdução e o genérico final. Lê os dados de tempo dos ficheiros .skiptro.json junto aos ficheiros de vídeo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Diálogo"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Fechar diálogo automaticamente após (segundos)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Saltar introduções automaticamente"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Saltar introdução"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Saltar genérico"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Saltar para a cena pós-genérico"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Não é possível ler os dados de salto. Verifique as permissões dos ficheiros."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Não é possível ler os dados de salto. Ative «Acesso a todos os ficheiros» para o Kodi nas definições do Android."
