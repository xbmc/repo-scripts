<?xml version="1.0" encoding="UTF-8"?>
<!-- MetaMender's picker, opened over the setup window (ui/select_window.py). Inline
     controls and fonts font10/12/13 only, as in script-metamender-setup.xml. Positions
     are those of the largest list (seven rows); onInit shrinks the panel and list
     and moves Cancel up to fit fewer options. -->
<window>
    <zorder>2</zorder>
    <!-- The list is filled in onInit, so it cannot take focus when the window opens. -->
    <defaultcontrol always="true">23</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="99060607">metamender/white.png</texture>
            <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
        </control>
        <control type="group" id="10">
            <left>460</left><top>111</top><width>1000</width><height>858</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="200"/>
                <effect type="zoom" start="96" end="100" center="auto" tween="sine" easing="out" time="200"/>
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="zoom" start="100" end="96" center="auto" tween="sine" easing="out" time="150"/>
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="150"/>
            </animation>

            <control type="image" id="11">
                <left>0</left><top>0</top><width>1000</width><height>858</height>
                <texture border="20" colordiffuse="FF1A1D23">metamender/panel.png</texture>
            </control>
            <control type="image" id="12">
                <left>0</left><top>0</top><width>1000</width><height>858</height>
                <texture border="20" colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/frame.png</texture>
            </control>

            <!-- Heading: the heartbeat badge and the title, centred together. -->
            <control type="grouplist">
                <left>50</left><top>36</top><width>900</width><height>56</height>
                <orientation>horizontal</orientation>
                <align>center</align>
                <itemgap>16</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="group">
                    <top>6</top><width>44</width><height>44</height>
                    <control type="image"><width>44</width><height>44</height><texture colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/badge.png</texture></control>
                    <control type="image"><width>44</width><height>44</height><texture colordiffuse="FF060607">metamender/pulse.png</texture></control>
                </control>
                <control type="label">
                    <width>auto</width><height>56</height>
                    <aligny>center</aligny>
                    <font>font13</font>
                    <textcolor>$INFO[Window(Home).Property(MetaMender.Accent)]</textcolor>
                    <label>[B]$INFO[Window.Property(MM.Heading)][/B]</label>
                </control>
            </control>
            <control type="image">
                <left>100</left><top>102</top><width>800</width><height>3</height>
                <texture colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/divider.png</texture>
                <animation effect="fade" start="70" end="70" time="0" condition="true">Conditional</animation>
            </control>

            <control type="list" id="100">
                <left>50</left><top>130</top><width>900</width><height>588</height>
                <orientation>vertical</orientation>
                <scrolltime>120</scrolltime>
                <pagecontrol>101</pagecontrol>
                <!-- Without an onup that is not the list itself, Up on the first row
                     wraps to the last. -->
                <onup>noop</onup>
                <ondown>23</ondown>
                <onright>101</onright>
                <itemlayout width="900" height="84">
                    <control type="image">
                        <left>0</left><top>0</top><width>900</width><height>74</height>
                        <texture border="12" colordiffuse="FF222731">metamender/row.png</texture>
                    </control>
                    <control type="image">
                        <left>26</left><top>22</top><width>30</width><height>30</height>
                        <texture colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/radio_on.png</texture>
                        <visible>String.IsEqual(ListItem.Property(marker),radio) + String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="image">
                        <left>26</left><top>22</top><width>30</width><height>30</height>
                        <texture colordiffuse="44FFFFFF">metamender/radio_off.png</texture>
                        <visible>String.IsEqual(ListItem.Property(marker),radio) + !String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <!-- The labels move right of the marker when the row shows one. -->
                    <control type="group">
                        <animation effect="slide" start="48,0" end="48,0" time="0" condition="!String.IsEmpty(ListItem.Property(marker))">Conditional</animation>
                        <!-- A row without a detail line centres its label. -->
                        <control type="label">
                            <left>28</left><top>0</top><width>800</width><height>74</height>
                            <aligny>center</aligny>
                            <font>font13</font>
                            <textcolor>FFF1F3F5</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>String.IsEmpty(ListItem.Property(detail))</visible>
                        </control>
                        <control type="label">
                            <left>28</left><top>4</top><width>800</width><height>36</height>
                            <aligny>center</aligny>
                            <font>font13</font>
                            <textcolor>FFF1F3F5</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>!String.IsEmpty(ListItem.Property(detail))</visible>
                        </control>
                        <control type="label">
                            <left>28</left><top>38</top><width>800</width><height>30</height>
                            <aligny>center</aligny>
                            <font>font10</font>
                            <textcolor>FF9299A6</textcolor>
                            <label>$INFO[ListItem.Property(detail)]</label>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="900" height="84">
                    <control type="image">
                        <left>0</left><top>0</top><width>900</width><height>74</height>
                        <texture border="12" colordiffuse="FF222731">metamender/row.png</texture>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>900</width><height>74</height>
                        <texture border="12" colordiffuse="FF2E3440">metamender/row.png</texture>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>0</top><width>6</width><height>74</height>
                        <texture colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/white.png</texture>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="image">
                        <left>26</left><top>22</top><width>30</width><height>30</height>
                        <texture colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/radio_on.png</texture>
                        <visible>String.IsEqual(ListItem.Property(marker),radio) + String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <control type="image">
                        <left>26</left><top>22</top><width>30</width><height>30</height>
                        <texture colordiffuse="44FFFFFF">metamender/radio_off.png</texture>
                        <visible>String.IsEqual(ListItem.Property(marker),radio) + !String.IsEqual(ListItem.Property(chosen),true)</visible>
                    </control>
                    <!-- The labels move right of the marker when the row shows one. -->
                    <control type="group">
                        <animation effect="slide" start="48,0" end="48,0" time="0" condition="!String.IsEmpty(ListItem.Property(marker))">Conditional</animation>
                        <!-- A row without a detail line centres its label. -->
                        <control type="label">
                            <left>28</left><top>0</top><width>800</width><height>74</height>
                            <aligny>center</aligny>
                            <font>font13</font>
                            <textcolor>FFF1F3F5</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>String.IsEmpty(ListItem.Property(detail))</visible>
                        </control>
                        <control type="label">
                            <left>28</left><top>4</top><width>800</width><height>36</height>
                            <aligny>center</aligny>
                            <font>font13</font>
                            <textcolor>FFF1F3F5</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                            <visible>!String.IsEmpty(ListItem.Property(detail))</visible>
                        </control>
                        <control type="label">
                            <left>28</left><top>38</top><width>800</width><height>30</height>
                            <aligny>center</aligny>
                            <font>font10</font>
                            <textcolor>FF9299A6</textcolor>
                            <label>$INFO[ListItem.Property(detail)]</label>
                        </control>
                    </control>
                </focusedlayout>
            </control>
            <control type="scrollbar" id="101">
                <left>962</left><top>130</top><width>6</width><height>578</height>
                <orientation>vertical</orientation>
                <showonepage>false</showonepage>
                <texturesliderbackground colordiffuse="FF222731">metamender/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="$INFO[Window(Home).Property(MetaMender.Accent)]">metamender/white.png</texturesliderbarfocus>
                <textureslidernib></textureslidernib>
                <textureslidernibfocus></textureslidernibfocus>
                <onleft>100</onleft>
            </control>

            <control type="button" id="23">
                <left>370</left><top>746</top><width>260</width><height>72</height>
                <align>center</align><aligny>center</aligny>
                <font>font13</font>
                <textcolor>FFF1F3F5</textcolor>
                <focusedcolor>$INFO[Window(Home).Property(MetaMender.ButtonTextFocused)]</focusedcolor>
                <pulseonselect>false</pulseonselect>
                <label>$INFO[Window.Property(MM.Cancel)]</label>
                <texturenofocus border="20" colordiffuse="FF2A2F38">metamender/button.png</texturenofocus>
                <texturefocus border="20" colordiffuse="$INFO[Window(Home).Property(MetaMender.ButtonFocus)]">metamender/button.png</texturefocus>
                <onup>100</onup>
            </control>
        </control>
    </controls>
</window>
