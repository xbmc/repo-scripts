msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Butang langkau intro/kredit"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Memaparkan butang langkau semasa intro dan kredit penutup. Membaca data masa daripada fail .skiptro.json di sebelah fail video."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Tutup dialog secara automatik selepas (saat)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Langkau intro secara automatik"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Langkau Intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Langkau Kredit"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Langkau ke Babak Pasca Kredit"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Tidak dapat membaca data langkau. Semak kebenaran fail."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Tidak dapat membaca data langkau. Hidupkan “Akses semua fail” untuk Kodi dalam tetapan Android."
