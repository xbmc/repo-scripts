msgctxt "Addon Summary"
msgid "Download and Install Kodi packages."
msgstr "Scarica e installa i pacchetti di Kodi."

msgctxt "Addon Description"
msgid "Download and Install Kodi Windows executables; select from  Nightlies, Releases, Snapshots and Test-builds."
msgstr "Scarica e installa gli eseguibili Windows di Kodi; seleziona da Nightlies, Release, Snapshot e Test-build."

msgctxt "Addon Disclaimer"
msgid "UWP not supported! Not intended for Kodi installation through the Windows Store."
msgstr "UWP non supportato! Non destinato all'installazione di Kodi tramite Windows Store."

msgctxt "#30000"
msgid "Enable Debugging [Log errors]"
msgstr "Abilita debug [registra errori]"

msgctxt "#30001"
msgid "Something went wrong, Try again later..."
msgstr "Qualcosa è andato storto, riprova più tardi..."

msgctxt "#30002"
msgid "Downloading..."
msgstr "Download in corso..."

msgctxt "#30003"
msgid "Keep all downloads?"
msgstr "Mantenere tutti i download?"

msgctxt "#30004"
msgid "File already exists"
msgstr "Il file esiste già"

msgctxt "#30005"
msgid "Install"
msgstr "Installa"

msgctxt "#30006"
msgid "Redownload"
msgstr "Scarica di nuovo"

msgctxt "#30007"
msgid "Installation Complete, File Removed"
msgstr "Installazione completata, file rimosso"

msgctxt "#30008"
msgid "Cleanup download after installation"
msgstr "Elimina il file scaricato dopo l'installazione"

msgctxt "#30009"
msgid "UWP Installations Not Supported!"
msgstr "Installazioni UWP non supportate!"

msgctxt "#30010"
msgid "/../../Users/*/AppData/Local/Packages/XBMCFoundation.Kodi_*"
msgstr "/../../Users/*/AppData/Local/Packages/XBMCFoundation.Kodi_*"

msgctxt "#30011"
msgid "Plugin disabled"
msgstr "Plugin disabilitato"

msgctxt "#30012"
msgid "Would you like to disable this plugin?"
msgstr "Vuoi disabilitare questo plugin?"

msgctxt "#30014"
msgid "Current Windows Platform (%s)"
msgstr "Piattaforma Windows attuale (%s)"

msgctxt "#30015"
msgid "Semi-stable (Monthly builds)."
msgstr "Semi-stabile (build mensili)."

msgctxt "#30016"
msgid "Stable (Final releases)."
msgstr "Stabile (versioni finali)."

msgctxt "#30017"
msgid "Unstable (Daily builds)."
msgstr "Instabile (build giornaliere)."

msgctxt "#30018"
msgid "Experimental (Debugging builds)."
msgstr "Sperimentale (build di debug)."

msgctxt "#30019"
msgid "Incompatible platform"
msgstr "Piattaforma incompatibile"

msgctxt "#30020"
msgid "Enable Silent Installation"
msgstr "Abilita installazione invisibile all'utente"

msgctxt "#30021"
msgid "Current Kodi Branch (%s.%s-%s)"
msgstr "Branch attuale Kodi (%s.%s-%s)"

msgctxt "#30023"
msgid "[B]Downloading:[/B]"
msgstr "[B]Download in corso:[/B]"

msgctxt "#30024"
msgid " | [B]Speed:[/B]"
msgstr " | [B]Velocità:[/B]"

