msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Button para laktawan ang intro/credits"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Nagpapakita ng button para lumaktaw habang nagpe-play ang intro at credits. Binabasa ang timing data mula sa mga file na .skiptro.json na katabi ng mga video file."

msgctxt "#32001"
msgid "Dialog"
msgstr "Dialog"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Awtomatikong isara ang dialog pagkalipas ng (segundo)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Awtomatikong laktawan ang mga intro"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Laktawan ang Intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Laktawan ang Credits"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Lumaktaw sa Post-Credits"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Hindi mabasa ang skip data. Tingnan ang mga pahintulot ng file."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Hindi mabasa ang skip data. I-on ang “Access sa lahat ng file” para sa Kodi sa mga setting ng Android."
