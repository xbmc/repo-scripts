msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Интро/титртӕ ауадзыны кнопкӕ"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Интро ӕмӕ кӕроны титрты рӕстӕг ӕвдисы ауадзыны кнопкӕ. Рӕстӕджы бӕрӕггӕнӕнтӕ кӕсы видеофайлты фарсмӕ ӕвӕрд .skiptro.json файлтӕй."

msgctxt "#32001"
msgid "Dialog"
msgstr "Диалог"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Диалог автоматикон ӕгъдауӕй сӕхгӕнын (секунды фӕстӕ)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Интротӕ автоматикон ӕгъдауӕй ауадзын"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Интро ауадзын"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Титртӕ ауадзын"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Титрты фӕстӕ сценӕмӕ ахизын"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Ауадзыны бӕрӕггӕнӕнтӕ кӕсӕн нӕй. Файлы бартӕ сбӕрӕг кӕн."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Ауадзыны бӕрӕггӕнӕнтӕ кӕсӕн нӕй. Android-ы уагӕвӕрдты Kodi-йӕн «Ӕппӕт файлтӕм бацӕуӕн» баиу кӕн."
