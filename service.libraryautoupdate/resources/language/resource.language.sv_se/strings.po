msgstr "Välj hur ofta biblioteksgenomsökningar ska startas"

msgctxt "#30080"
msgid "Set a custom interval using cron syntax - example is '15 */5 * * *' for quarter past the hour every 5 hours every day"
msgstr "Ange ett anpassat intervall med hjälp av cron-syntax - exempel är \"15 */5 * * *\" för kvart över en timme var 5:e timme varje dag"

msgctxt "#30081"
