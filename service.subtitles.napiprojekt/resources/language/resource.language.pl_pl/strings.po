msgctxt "#32001"
msgid "Failed to download the subtitle"
msgstr "Nie udało się pobrać napisów"

msgctxt "#32002"
msgid "No matching subtitles were found"
msgstr "Nie znaleziono pasujących napisów"

msgctxt "#32003"
msgid "Kodi did not provide a video file"
msgstr "Kodi nie przekazało pliku wideo"

msgctxt "#32004"
msgid "Could not calculate the video hash"
msgstr "Nie udało się obliczyć hasha pliku wideo"

msgctxt "#32005"
msgid "NapiProjekt request limit reached. Try again later"
msgstr "Osiągnięto limit zapytań NapiProjektu. Spróbuj później"

msgctxt "#32006"
msgid "Could not connect to NapiProjekt"
msgstr "Nie udało się połączyć z NapiProjektem"

msgctxt "#32007"
msgid "NapiProjekt returned an invalid response"
msgstr "NapiProjekt zwrócił nieprawidłową odpowiedź"
