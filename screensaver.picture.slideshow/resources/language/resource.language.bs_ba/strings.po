msgctxt "Addon Summary"
msgid "Screensaver that displays an image slideshow"
msgstr "Čuvar ekrana koji prikazuje slajdove sa slikama"

msgctxt "Addon Description"
msgid "The Slideshow screensaver will show you a slide show of images using various transition effects. It can be configured to show your libraries music or video fanart, or a custom folder of images"
msgstr "Čuvar ekrana za klizaje će vam prikazati klizajku slika koristeći razne efekte prijelaza. Može se konfigurirati da prikazuje muziku ili video umjetnost obožavatelja iz vaše biblioteke ili prilagođenu mapu sa slikama"

msgctxt "#30000"
msgid "Source of slideshow images"
msgstr "Izvor slika za prezentaciju"

msgctxt "#30001"
msgid "Folder"
msgstr "Fascikle"

msgctxt "#30002"
msgid "Video Fanart"
msgstr "Video umjetnost obožavatelja"

msgctxt "#30003"
msgid "Music Fanart"
msgstr "Muzička fanart"

msgctxt "#30004"
msgid "Image Folder"
msgstr "Mapa slika"

msgctxt "#30005"
msgid "Dim level"
msgstr "Nivo zatamnjenja"

msgctxt "#30006"
msgid "Effect"
msgstr "Efekat"

msgctxt "#30007"
msgid "Slide"
msgstr "Klizajka"

msgctxt "#30008"
msgid "Crossfade"
msgstr "Pretapanje"

msgctxt "#30009"
msgid "Pan and zoom"
msgstr "Pomicanje i zumiranje"

msgctxt "#30010"
msgid "Amount of seconds to display each image"
msgstr "Broj sekundi za prikaz svake slike"

msgctxt "#30011"
msgid "Scale images fullscreen"
msgstr "Skaliranje slika preko cijelog ekrana"

msgctxt "#30012"
msgid "Display image name"
msgstr "Naziv prikazane slike"

msgctxt "#30013"
msgid "Disabled"
msgstr "Onemogućeno"

msgctxt "#30014"
msgid "Use filename"
msgstr "Koristi naziv datoteke"

msgctxt "#30015"
msgid "Use foldername"
msgstr "Koristi naziv mape"

msgctxt "#30016"
msgid "Display images in random order"
msgstr "Prikaz slika nasumičnim redoslijedom"

msgctxt "#30017"
msgid "Use full path"
msgstr "Koristi punu putanju"

# empty string with id 30017
msgctxt "#30018"
msgid "Use folder- and filename"
msgstr "Koristite naziv mape i datoteke"

# empty strings from id 30019 to 30020
msgctxt "#30021"
msgid "Display picture date"
msgstr "Prikaz datuma slike"

msgctxt "#30022"
msgid "Display additional picture tags"
msgstr "Prikaži dodatne oznake slika"

msgctxt "#30023"
msgid "Display music info during audio playback"
msgstr "Prikaz informacija o muzici tokom reprodukcije zvuka"

msgctxt "#30024"
msgid "Basic"
msgstr "Osnovno"

msgctxt "#30025"
msgid "Additional"
msgstr "Dodatno"

msgctxt "#30026"
msgid "Resume slideshow from last position"
msgstr "Nastavi klizajku od posljednje pozicije"

# empty strings from id 30027 to 30028
msgctxt "#30029"
msgid "Display background picture"
msgstr "Prikaži pozadinsku sliku"

msgctxt "#30030"
msgid "Use vignette overlay"
msgstr "Koristi preklapanje vinjeta"

msgctxt "#30031"
msgid "Stop slideshow after a set time"
msgstr ""

msgctxt "#30032"
msgid "Stop after (minutes)"
msgstr ""
