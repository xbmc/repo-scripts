msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Last.fm-kirjaus"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Kirjauspalvelu lähettää Kodissa toistamiesi kappaleiden tiedot Last.fm-palveluun"

msgctxt "#30000"
msgid "General"
msgstr "Yleiset"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Lähetä kappaleiden tiedot Last.fm-palveluun"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Lähetä suoratoistoradion tiedot Last.fm-palveluun"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Last.fm-käyttäjätunnus"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Last.fm-salasana"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Vahvista Tykkää- ja Estä-valintojen lähetys"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Lähetä musiikkivideoiden tiedot Last.fm-palveluun"

