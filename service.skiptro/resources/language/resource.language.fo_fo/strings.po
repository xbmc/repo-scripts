msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Knøttur at loypa um intro/rulltekstir"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Vísir ein knøtt til at loypa um, meðan intro og rulltekstir verða vístir. Lesur tíðarupplýsingar úr .skiptro.json fílum, sum liggja við síðuna av videofílunum."

msgctxt "#32001"
msgid "Dialog"
msgstr "Samrøðugluggi"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Lat samrøðugluggan aftur sjálvvirkandi eftir (sekund)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Loyp sjálvvirkandi um intro"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Loyp um intro"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Loyp um rulltekstir"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Loyp til eftirsenu"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Kann ikki lesa dátur til at loypa um. Kanna loyvini hjá fíluni."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Kann ikki lesa dátur til at loypa um. Tendra „Atgongd til allar fílur“ fyri Kodi í Android-stillingunum."
