msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Sarrera/kredituak saltatzeko botoia"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Saltatzeko botoi bat erakusten du sarreran eta amaierako kredituetan. Denbora-datuak bideo-fitxategien ondoko .skiptro.json fitxategietatik irakurtzen ditu."

msgctxt "#32001"
msgid "Dialog"
msgstr "Elkarrizketa-koadroa"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Elkarrizketa-koadroa automatikoki ixteko denbora (segundoak)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Saltatu sarrerak automatikoki"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Saltatu sarrera"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Saltatu kredituak"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Joan kredituen osteko eszenara"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Ezin dira saltatzeko datuak irakurri. Egiaztatu fitxategiaren baimenak."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Ezin dira saltatzeko datuak irakurri. Aktibatu «Fitxategi guztietarako sarbidea» Kodi aplikaziorako Android ezarpenetan."
