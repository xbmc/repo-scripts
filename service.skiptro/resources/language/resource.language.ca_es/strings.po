msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Botó per ometre la introducció i els crèdits"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Mostra un botó per ometre la introducció i els crèdits finals. Llegeix les dades de temps dels fitxers .skiptro.json situats al costat dels fitxers de vídeo."

msgctxt "#32001"
msgid "Dialog"
msgstr "Diàleg"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Tanca el diàleg automàticament després de (segons)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Omet automàticament les introduccions"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Omet la introducció"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Omet els crèdits"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Salta a l'escena postcrèdits"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "No es poden llegir les dades d'omissió. Comproveu els permisos dels fitxers."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "No es poden llegir les dades d'omissió. Activeu «Accés a tots els fitxers» per a Kodi a la configuració d'Android."
