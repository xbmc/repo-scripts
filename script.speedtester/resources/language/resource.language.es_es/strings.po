msgctxt "#30900"
msgid "Server"
msgstr "Servidor"

msgctxt "#30901"
msgid "Server selection"
msgstr "Selección de servidor"

msgctxt "#30902"
msgid "Server selection"
msgstr "Selección de servidor"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Elige cómo se selecciona el servidor de prueba."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automático (más cercano)"

msgctxt "#30905"
msgid "By location"
msgstr "Por ubicación"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "ID de servidor específico"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Ubicación (ciudad o país)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Buscar servidores en una ciudad o país concretos."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID de servidor"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Probar siempre con este ID de servidor de speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Preferir servidores HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Usar solo servidores que admitan conexiones HTTPS seguras."

msgctxt "#30920"
msgid "Test"
msgstr "Prueba"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Probar velocidad de subida"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Desactiva para una prueba solo de descarga."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Enviar resultados a speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Sube el resultado a speedtest.net y muestra la imagen del resultado."

msgctxt "#30930"
msgid "Advanced"
msgstr "Avanzado"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Tiempo de espera de conexión (segundos)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Tiempo de espera de red para cada petición."

msgctxt "#30933"
msgid "Log level"
msgstr "Nivel de registro"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Cantidad de detalle escrito en el registro de Kodi."

msgctxt "#30935"
msgid "Quiet"
msgstr "Silencioso"

msgctxt "#30936"
msgid "Info"
msgstr "Info"

msgctxt "#30937"
msgid "Verbose"
msgstr "Detallado"

msgctxt "#30938"
msgid "Debug"
msgstr "Depuración"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]Iniciar test de velocidad[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Cerrar[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Por favor, espera…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Ejecutando el add-on de test de velocidad[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Obteniendo la configuración de speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Obteniendo la lista de servidores de speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Probando desde {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Seleccionando el mejor servidor según la latencia"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Alojado por: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Servidor: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Ciudad: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "País: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Distancia: {d:0.2f} km"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Ping: {latency} ms"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Probando velocidad de descarga…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Velocidad de descarga: {speed:0.2f} Mbps"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Probando velocidad de subida…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Velocidad de subida: {speed:0.2f} Mbps"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Velocidad de descarga recomendada para streaming de vídeo:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3 a 5 Mbps para vídeo SD 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5 a 10 Mbps para vídeo HD 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Mbps para el mejor 1080p o TV en directo"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25 a 50+ Mbps para streaming 4K"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Las velocidades mostradas pueden depender de las limitaciones del dispositivo.[/I]"
