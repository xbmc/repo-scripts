msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Hnappur til að sleppa kynningu/kreditlista"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Sýnir sleppihnapp meðan á kynningu og kreditlista stendur. Les tímasetningargögn úr .skiptro.json-skrám við hlið myndskránna."

msgctxt "#32001"
msgid "Dialog"
msgstr "Samskiptagluggi"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Loka glugga sjálfkrafa eftir (sekúndur)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Sleppa kynningum sjálfkrafa"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Sleppa kynningu"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Sleppa kreditlista"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Fara í aukaatriði"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Ekki tókst að lesa sleppigögn. Athugaðu skráarheimildir."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Ekki tókst að lesa sleppigögn. Kveiktu á „Aðgangur að öllum skrám“ fyrir Kodi í stillingum Android."
