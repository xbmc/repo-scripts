msgid "Connection removed. You can connect again in the add-on settings."
msgstr "Conexión eliminada. Puedes volver a conectarte en los ajustes del complemento."

msgctxt "#32019"
msgid "WatchNPlay Pro is needed to keep syncing."
msgstr "Necesitas WatchNPlay Pro para seguir sincronizando."

msgctxt "#32020"
msgid "Disconnected from WatchNPlay."
msgstr "Desconectado de WatchNPlay."

msgctxt "#32021"
msgid "Disconnect this device from WatchNPlay?"
msgstr "¿Desconectar este dispositivo de WatchNPlay?"

msgctxt "#32022"
msgid "Sync started."
msgstr "Sincronización iniciada."

msgctxt "#32024"
