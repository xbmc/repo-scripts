msgstr "Verbunden mit %s"

msgctxt "#32015"
msgid "Code expired, getting a new one…"
msgstr "Code abgelaufen, neuer Code wird geholt …"

msgctxt "#32016"
msgid "Too many attempts. Please try again later."
msgstr "Zu viele Versuche. Bitte versuch es später noch einmal."

