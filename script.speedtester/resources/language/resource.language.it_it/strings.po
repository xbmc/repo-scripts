msgctxt "#30900"
msgid "Server"
msgstr "Server"

msgctxt "#30901"
msgid "Server selection"
msgstr "Selezione server"

msgctxt "#30902"
msgid "Server selection"
msgstr "Selezione server"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Scegli come viene selezionato il server di test."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Automatico (più vicino)"

msgctxt "#30905"
msgid "By location"
msgstr "Per località"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "ID server specifico"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Località (città o paese)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Cerca server in una città o paese specifici."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID server"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Esegui sempre il test con questo ID server di speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Preferisci server HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Usa solo server che supportano connessioni HTTPS sicure."

msgctxt "#30920"
msgid "Test"
msgstr "Test"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Testa velocità di upload"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Disattiva per un test solo di download."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Invia i risultati a speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Carica il risultato su speedtest.net e mostra l'immagine del risultato."

msgctxt "#30930"
msgid "Advanced"
msgstr "Avanzate"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Timeout di connessione (secondi)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Timeout di rete per ogni richiesta."

msgctxt "#30933"
msgid "Log level"
msgstr "Livello di log"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Quantità di dettagli scritti nel log di Kodi."

msgctxt "#30935"
msgid "Quiet"
msgstr "Silenzioso"

msgctxt "#30936"
msgid "Info"
msgstr "Info"

msgctxt "#30937"
msgid "Verbose"
msgstr "Dettagliato"

msgctxt "#30938"
msgid "Debug"
msgstr "Debug"

