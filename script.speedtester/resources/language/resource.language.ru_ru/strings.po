msgctxt "#30900"
msgid "Server"
msgstr "Сервер"

msgctxt "#30901"
msgid "Server selection"
msgstr "Выбор сервера"

msgctxt "#30902"
msgid "Server selection"
msgstr "Выбор сервера"

msgctxt "#30903"
msgid "Choose how the test server is selected."
msgstr "Выберите способ выбора тестового сервера."

msgctxt "#30904"
msgid "Automatic (nearest)"
msgstr "Автоматически (ближайший)"

msgctxt "#30905"
msgid "By location"
msgstr "По местоположению"

msgctxt "#30906"
msgid "Specific server ID"
msgstr "Определённый ID сервера"

msgctxt "#30907"
msgid "Location (city or country)"
msgstr "Местоположение (город или страна)"

msgctxt "#30908"
msgid "Search for servers in a specific city or country."
msgstr "Искать серверы в определённом городе или стране."

msgctxt "#30909"
msgid "Server ID"
msgstr "ID сервера"

msgctxt "#30910"
msgid "Always test against this speedtest.net server ID."
msgstr "Всегда тестировать с этим ID сервера speedtest.net."

msgctxt "#30911"
msgid "Prefer HTTPS servers"
msgstr "Предпочитать серверы HTTPS"

msgctxt "#30912"
msgid "Only use servers that support secure HTTPS connections."
msgstr "Использовать только серверы с поддержкой защищённых HTTPS-соединений."

msgctxt "#30920"
msgid "Test"
msgstr "Тест"

msgctxt "#30921"
msgid "Test upload speed"
msgstr "Проверять скорость отдачи"

msgctxt "#30922"
msgid "Disable to run a download-only test."
msgstr "Отключите для теста только загрузки."

msgctxt "#30923"
msgid "Submit results to speedtest.net"
msgstr "Отправлять результаты на speedtest.net"

msgctxt "#30924"
msgid "Upload the result to speedtest.net and show the result image."
msgstr "Загрузить результат на speedtest.net и показать изображение результата."

msgctxt "#30930"
msgid "Advanced"
msgstr "Дополнительно"

msgctxt "#30931"
msgid "Connection timeout (seconds)"
msgstr "Тайм-аут соединения (секунды)"

msgctxt "#30932"
msgid "Network timeout for each request."
msgstr "Сетевой тайм-аут для каждого запроса."

msgctxt "#30933"
msgid "Log level"
msgstr "Уровень журналирования"

msgctxt "#30934"
msgid "Amount of detail written to the Kodi log."
msgstr "Объём подробностей в журнале Kodi."

msgctxt "#30935"
msgid "Quiet"
msgstr "Тихо"

msgctxt "#30936"
msgid "Info"
msgstr "Инфо"

msgctxt "#30937"
msgid "Verbose"
msgstr "Подробно"

msgctxt "#30938"
msgid "Debug"
msgstr "Отладка"

msgctxt "#30950"
msgid "[B]Run Speedtest[/B]"
msgstr "[B]Запустить тест скорости[/B]"

msgctxt "#30951"
msgid "[B]Close[/B]"
msgstr "[B]Закрыть[/B]"

msgctxt "#30952"
msgid "Please wait…"
msgstr "Пожалуйста, подождите…"

msgctxt "#30960"
msgid "[B]Running Speed Test add-on[/B]"
msgstr "[B]Дополнение теста скорости выполняется[/B]"

msgctxt "#30961"
msgid "Retrieving speedtest.net configuration"
msgstr "Получение конфигурации speedtest.net"

msgctxt "#30962"
msgid "Retrieving speedtest.net server list"
msgstr "Получение списка серверов speedtest.net"

msgctxt "#30963"
msgid "Testing from {isp} ({ip})"
msgstr "Тест от {isp} ({ip})"

msgctxt "#30964"
msgid "Selecting best server based on latency"
msgstr "Выбор лучшего сервера по задержке"

msgctxt "#30965"
msgid "Hosted by: {sponsor}"
msgstr "Провайдер: {sponsor}"

msgctxt "#30966"
msgid "Host server: {host}"
msgstr "Сервер: {host}"

msgctxt "#30967"
msgid "City, State: {name}"
msgstr "Город: {name}"

msgctxt "#30968"
msgid "Country: {country}"
msgstr "Страна: {country}"

msgctxt "#30969"
msgid "Distance: {d:0.2f} km"
msgstr "Расстояние: {d:0.2f} км"

msgctxt "#30970"
msgid "Ping: {latency} ms"
msgstr "Пинг: {latency} мс"

msgctxt "#30971"
msgid "Testing download speed…"
msgstr "Проверка скорости загрузки…"

msgctxt "#30972"
msgid "Download speed: {speed:0.2f} Mbps"
msgstr "Скорость загрузки: {speed:0.2f} Мбит/с"

msgctxt "#30973"
msgid "Testing upload speed…"
msgstr "Проверка скорости отдачи…"

msgctxt "#30974"
msgid "Upload speed: {speed:0.2f} Mbps"
msgstr "Скорость отдачи: {speed:0.2f} Мбит/с"

msgctxt "#30980"
msgid "[B]Recommended download speed for video streaming:[/B]"
msgstr "[B]Рекомендуемая скорость загрузки для видеостриминга:[/B]"

msgctxt "#30981"
msgid "- 3 to 5 Mbps for viewing SD-quality 480p video"
msgstr "- 3–5 Мбит/с для видео SD 480p"

msgctxt "#30982"
msgid "- 5 to 10 Mbps for viewing HD-quality 720p video"
msgstr "- 5–10 Мбит/с для видео HD 720p"

msgctxt "#30983"
msgid "- 10+ Mbps for the best 1080p or Live TV experience"
msgstr "- 10+ Мбит/с для наилучшего 1080p или прямого эфира"

msgctxt "#30984"
msgid "- 25 to 50+ Mbps for 4K streaming"
msgstr "- 25–50+ Мбит/с для стриминга 4K"

msgctxt "#30985"
msgid "[I]Reported speeds may be due to the limitations of the device.[/I]"
msgstr "[I]Показанные скорости могут зависеть от ограничений устройства.[/I]"
