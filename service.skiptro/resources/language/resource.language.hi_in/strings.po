msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "इंट्रो/क्रेडिट्स स्किप करने का बटन"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "इंट्रो और क्रेडिट्स के दौरान स्किप बटन दिखाता है। वीडियो फ़ाइलों के पास रखी .skiptro.json फ़ाइलों से समय का डेटा पढ़ता है।"

msgctxt "#32001"
msgid "Dialog"
msgstr "डायलॉग"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "डायलॉग अपने आप बंद होने का समय (सेकंड)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "इंट्रो अपने आप स्किप करें"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "इंट्रो स्किप करें"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "क्रेडिट्स स्किप करें"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "पोस्ट-क्रेडिट सीन पर जाएँ"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "स्किप डेटा नहीं पढ़ा जा सका। फ़ाइल अनुमतियाँ जाँचें।"

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "स्किप डेटा नहीं पढ़ा जा सका। Android सेटिंग में Kodi के लिए “सभी फ़ाइलों का ऐक्सेस” चालू करें।"
