msgctxt "Addon Summary"
msgid "Last.fm scrobbler"
msgstr "Last.fm scrobbler"

msgctxt "Addon Description"
msgid "The Last.fm scrobbler will submit info of the songs you've been listening to in Kodi to last.fm"
msgstr "Last.fm scrobbler informará de las canciones que has estado escuchando en Kodi a Last.fm"

msgctxt "#30000"
msgid "General"
msgstr "General"

msgctxt "#30001"
msgid "Submit songs to Last.fm"
msgstr "Enviar canciones a Last.fm"

msgctxt "#30002"
msgid "Submit streaming radio to Last.fm"
msgstr "Enviar radio en streaming a Last.fm"

msgctxt "#30003"
msgid "Last.fm username"
msgstr "Usuario de Last.fm"

msgctxt "#30004"
msgid "Last.fm password"
msgstr "Contraseña de Last.fm"

msgctxt "#30005"
msgid "Confirm Love submissions"
msgstr "Confirmar envío de Favoritos/Vetados"

msgctxt "#30006"
msgid "Submit music videos to Last.fm"
msgstr "Enviar vídeos musicales a Last.fm"

# empty strings with id 300007
msgctxt "#30008"
msgid "Advanced"
msgstr "Avanzado"

# empty strings from id 300007 to 32008
msgctxt "#30009"
msgid "Enable logging"
msgstr "Activar el registro"

msgctxt "#30010"
msgid "In case of multiple artists, only use the first one"
msgstr "En caso de múltiples intérpretes, usar solo el primero"

