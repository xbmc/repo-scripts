msgctxt "#32003"
msgid "Disconnect"
msgstr "Desconectar"

msgctxt "#32004"
msgid "Sync now"
msgstr "Sincronizar agora"

msgctxt "#32005"
msgid "Not connected"
msgstr "Não conectado"

msgctxt "#32006"
msgid "Connected as %s"
msgstr "Conectado como %s"

msgctxt "#32008"
msgid "Paused: WatchNPlay Pro needed"
msgstr "Pausado: é preciso ter o WatchNPlay Pro"

msgctxt "#32009"
msgid "API address (for testing only)"
msgstr "Endereço da API (somente para testes)"

msgctxt "#32010"
msgid "Scan the QR code with your phone, or open Data & sync › Kodi in the app and enter this code:"
msgstr "Escaneie o QR code com o celular ou abra Dados e sincronização › Kodi no app e digite este código:"

