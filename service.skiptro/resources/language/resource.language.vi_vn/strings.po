msgctxt "Addon Summary"
msgid "Skip intro/credits button"
msgstr "Nút bỏ qua phần giới thiệu/danh đề"

msgctxt "Addon Description"
msgid "Displays a skip button during intro and credits sequences. Reads timing data from .skiptro.json files next to video files."
msgstr "Hiển thị nút bỏ qua trong phần giới thiệu và phần danh đề cuối phim. Đọc dữ liệu thời gian từ các tệp .skiptro.json nằm cạnh tệp video."

msgctxt "#32001"
msgid "Dialog"
msgstr "Hộp thoại"

msgctxt "#32002"
msgid "Auto-close dialog after (seconds)"
msgstr "Tự động đóng hộp thoại sau (giây)"

msgctxt "#32003"
msgid "Automatically skip intros"
msgstr "Tự động bỏ qua phần giới thiệu"

msgctxt "#32010"
msgid "Skip Intro"
msgstr "Bỏ qua giới thiệu"

msgctxt "#32011"
msgid "Skip Credits"
msgstr "Bỏ qua danh đề"

msgctxt "#32012"
msgid "Skip to Stinger"
msgstr "Chuyển đến cảnh sau danh đề"

msgctxt "#32020"
msgid "Can't read skip data. Check the file permissions."
msgstr "Không thể đọc dữ liệu bỏ qua. Hãy kiểm tra quyền truy cập tệp."

msgctxt "#32021"
msgid "Can't read skip data. Turn on \"All files access\" for Kodi in Android settings."
msgstr "Không thể đọc dữ liệu bỏ qua. Hãy bật “Quyền truy cập vào tất cả các tệp” cho Kodi trong phần cài đặt Android."
