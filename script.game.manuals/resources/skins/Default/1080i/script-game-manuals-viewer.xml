<?xml version="1.0" encoding="UTF-8"?>
<!-- The page is control 100. Its size here is the area the page is fitted to;
     the add-on then moves and resizes it to zoom and pan. -->
<window>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<animation effect="fade" time="200">WindowOpen</animation>
	<animation effect="fade" time="200">WindowClose</animation>
	<controls>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF000000">white.png</texture>
		</control>
		<control type="image" id="100">
			<width>1920</width>
			<height>1080</height>
			<aspectratio>stretch</aspectratio>
			<fadetime>150</fadetime>
		</control>
		<control type="group">
			<right>30</right>
			<bottom>30</bottom>
			<width>760</width>
			<height>100</height>
			<control type="image">
				<texture colordiffuse="C0000000">white.png</texture>
			</control>
			<control type="label">
				<left>20</left>
				<top>10</top>
				<width>720</width>
				<height>40</height>
				<font>font13</font>
				<align>right</align>
				<label>$INFO[Window.Property(page)]</label>
			</control>
			<control type="label">
				<left>20</left>
				<top>50</top>
				<width>720</width>
				<height>36</height>
				<font>font12</font>
				<textcolor>FFAAAAAA</textcolor>
				<align>right</align>
				<label>$ADDON[script.game.manuals 32012]</label>
			</control>
		</control>
	</controls>
</window>
